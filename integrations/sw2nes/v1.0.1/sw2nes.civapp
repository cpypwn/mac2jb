{"format":"civswitch-app","version":1,"id":"sw2nes","name":"SW2NES","metadata":{"author":"Rodpad","release":"1.0.1","description":"NES emulator for Nintendo Switch 2. Upload .nes files over FTP to Root/nes, then pick a game. L + R opens the in-game menu: save states, picture and audio settings, cheats and more.","api":1,"extensions":{"updates":{"schema":1,"releasesUrl":"https://github.com/Rodpad/SW2NES/releases/latest","asset":"sw2nes.civapp"}}},"scripts":[{"name":"app/notices.js","source":"/* SW2NES - NES emulator for CivHomebrew.\n *\n * The emulation core is QuickNES (libretro/QuickNES_Core, originally by\n * Shay Green / blargg), licensed under the GNU General Public License v2.\n * Source: https://github.com/libretro/QuickNES_Core\n * It is compiled to plain JavaScript with Emscripten 3.1.74 (wasm2js).\n * Modified by SW2NES: Nes_Cpu::run() (the 6502 interpreter) is replaced by a\n * JavaScript port with identical behaviour (native/cpu_lib.js, generated by\n * tools/gen_cpu.py; it also fast-forwards provably idle loops and accesses\n * unintercepted cartridge RAM directly, as Nes_Core::cpu_read/write do), selected by\n * SW2NES_JS_CPU in Nes_Cpu.cpp/.h. Pixel conversion is native/convert_lib.js; the\n * background renderer's common case is a JavaScript port (native/ppu_lib.js, SW2NES_JS_BG).\n * The background renderer (Nes_Ppu_Rendering.cpp, Nes_Ppu_Bg.h) is modified to\n * draw with aligned stores (SW2NES_ALIGNED_BG); built with NO_UNALIGNED_ACCESS. The\n * bridge, build script and frontend sources are distributed with this app's\n * source tree under the same license. This program comes with ABSOLUTELY NO\n * WARRANTY. No game ROMs are included.\n */\nvar SW2NESNotices = \"SW2NES uses QuickNES (GPL-2.0). Source: https://github.com/libretro/QuickNES_Core\";\n"},{"name":"dist/runtime/quicknes.js","source":"\nvar QuickNESCore = (() => {\n  var _scriptName = typeof document != 'undefined' ? document.currentScript?.src : undefined;\n  if (typeof __filename != 'un