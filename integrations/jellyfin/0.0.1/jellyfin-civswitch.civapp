{"format":"civswitch-app","version":1,"id":"jellyfin-civswitch","name":"Jellyfin","metadata":{"author":"SaoriYuki","release":"0.0.1","description":"Jellyfin pour Switch 2 par SaoriYuki. Catalogue, lecteur plein ecran et mise en tampon native. Logo Jellyfin : contributeurs Jellyfin, CC BY-SA 4.0.","api":1,"extensions":{"updates":null}},"scripts":[{"name":"third-party-notices.js","source":"/* Jellyfin logo: copyright Jellyfin contributors, Creative Commons\n * Attribution-ShareAlike 4.0 International. Rasterized from jellyfin/jellyfin-ux\n * branding/SVG/icon-transparent.svg; see BRANDING.md and tools/build_brand.py.\n * This client is unofficial and not endorsed by Jellyfin.\n */\n/* Native media components based on XITRIX/Moonlight-CivSwitch:\n * https://github.com/XITRIX/Moonlight-CivSwitch\n * Commit: 64cdae7f4a3f19202c7f8eaa0e5ac12ce3330d72\n * app/src/streaming/native-io.js\n * app/src/streaming/native-texture.js\n * app/src/streaming/native-media.js\n * Authors/credits: XITRIX; Gezine/CivSwitch and upstream contributors.\n * native-io.js and native-texture.js are reused unchanged. Native media is a\n * generated derivative (vendor/moonlight-native-media-vod.js) with three VOD\n * timing hooks, produced by tools/build_media_adapter.py. Original native ABI,\n * allocation and release code remains unchanged; downloaded sources are intact.\n * Original headers and attribution are preserved.\n * The Sunshine/Moonlight C protocol runtime, Forge, ENet and TLS libraries are\n * NOT bundled here. No affiliation or endorsement is implied.\n * The upstream repository has no root project-wide LICENSE at this revision;\n * this notice does not grant additional redistribution rights. This integration\n * is a local experimental build; clarify licensing before public redistribution.\n * The four original source/test files and upstream app/civapp-notices.js are\n * preserved in vendor/moonlight/. The supplied upstream notice lists third-party\n * component licenses, not an explicit blanket license for the native adapters.\n * See THIRD_PARTY.md for provenance, licensing scope and credits to XITRIX and Gezine.\n */\nwindow.JellyfinNativeProvenance={repository:\"https://github.com/XITRIX/Moonlight-CivSwitch\",commit:\"64cdae7f4a3f19202c7f8eaa0e5ac12ce3330d72\"};\n"},{"name":"brand.js","source":"/* Jellyfin contributors, CC BY-SA 4.0; see BRANDING.md. */\nwindow.JellyfinBrand={icon:\"data:image/png;base64,\"};\n"},{"name":"vendor/moonlight/app/src/streaming/native-io.js","source":"/* Translate the generated core's wasm32 socket ABI into CivSwitch SDK calls. */\n(function(global){\n \"use strict\";\n function create(transport,options){\n  options=options||{};\n  var allocations=[],descriptors=new Set(),bufferSize=2097152,heapBuffer=null,heapView=null,heapAddress=0n,socketTypes={},interruptAfter=Infinity;\n  var batchCore=null,batchHeap=0,batchFunction=null,batchSlots=[],batchSockets=new Map(),batchSize=32,packetSize=2048;\n  var batchSlotBytes=batchSize*(packetSize+56+16);\n  var directMetadata=0,directBase=0n,directCapacity=0;\n  function now(){return global.performance&&global.performance.now?global.performance.now():Date.now();}\n  function isInterrupted(){return interruptAfter!==Infinity&&now()>=interruptAfter;}\n  function alloc(size){var p=malloc(size);if(!p)throw Error(\"Native streaming allocation failed\");allocations.push(p);return p;}\n  function invoke(name,args){return call_rop.apply(null,[transport.resolveNativeSymbol(name)].concat((args||[]).map(BigInt)));}\n  function signed(value){return Number(BigInt.asIntN(32,value));}\n  function call(name,args){var result=signed(invoke(\"_ZN2nn6socket\"+name,args));return result<0?-Number(invoke(\"_ZN2nn6socket12GetLastErrnoEv\",[])):result;}\n  function copy(pointer,length){var bytes=new Uint8Array(length),view=new DataView(bytes.buffer),i=0;for(;i+8<=length;i+=8)view.setBigUint64(i,read64(pointer+BigInt(i)),true);for(;i<length;i++)bytes[i]=Number(read8(pointer+BigInt(i)));return bytes;