var key=p[1].toLowerCase();if(headers[key]!==undefined&&[\"content-length\",\"transfer-encoding\",\"content-encoding\",\"location\"].indexOf(key)>=0)fail(\"en-tete duplique.\");headers[key]=p[2].trim();});\n     if(status!==200)fail(\"HTTP \"+status+\" pour la demande video.\");\n     if(headers[\"content-encoding\"]&&headers[\"content-encoding\"].toLowerCase()!==\"identity\")fail(\"compression HTTP non prise en charge.\");\n     if(headers[\"transfer-encoding\"]!==undefined){if(headers[\"content-length\"]!==undefined||headers[\"transfer-encoding\"].toLowerCase()!==\"chunked\")fail(\"encadrement incompatible.\");chunked=true;}\n     if(headers[\"content-length\"]!==undefined){if(!/^\\d+$/.test(headers[\"content-length\"]))fail(\"longueur invalide.\");expected=Number(headers[\"content-length\"]);if(!Number.isSafeInteger(expected)||expected>(o.maxTotalBytes||17179869184))fail(\"longueur excessive.\");}\n     pending=pending.slice(at+4);state=chunked?\"size\":\"plain\";if(o.onHeaders)await o.onHeaders(status,headers);\n    }else if(state===\"plain\"){\n     if(expected!==null&&total+pending.length>expected)fail(\"corps plus grand que declare.\");var piece=pending;pending=\"\";await deliver(piece);if(expected!==null&&total===expected)done=true;return;\n    }else if(state===\"size\"){\n     var e=pending.indexOf(\"\\r\\n\");if(e<0){if(pending.length>1024)fail(\"taille de chunk invalide.\");return;}\n     var line=pending.slice(0,e);if(!/^[0-9a-f]{1,8}(?:;[\\x20-\\x7e]*)?$/i.test(line))fail(\"taille de chunk invalide.\");remaining=parseInt(line,16);pending=pending.slice(e+2);state=remaining?\"chunk\":\"trailers\";\n    }else if(state===\"chunk\"){\n     if(!pending.length)return;var n=Math.min(remaining,pending.length),part=pending.slice(0,n);pending=pending.slice(n);remaining-=n;await deliver(part);if(!remaining)state=\"crlf\";\n    }else if(state===\"crlf\"){\n     if(pending.length<2)return;if(pending.slice(0,2)!==\"\\r\\n\")fail(\"terminaison chunk invalide.\");pending=pending.slice(2);state=\"size\";\n    }else if(state===\"trailers\"){\n     var end=pending.indexOf(\"\\r\\n\");if(end<0){if(pending.length>32768)fail(\"trailers excessifs.\");return;}\n     trailerBytes+=end+2;if(trailerBytes>32768)fail(\"trailers excessifs.\");var trailer=pending.slice(0,end);pending=pending.slice(end+2);if(!trailer){done=true;state=\"done\";if(pending.length)fail(\"donnees apres la fin.\");return;}\n     if(!/^[A-Za-z0-9-]+:[\\x20-\\x7e\\t]*$/.test(trailer)||/^(content-length|transfer-encoding|location):/i.test(trailer))fail(\"trailer invalide.\");\n    }else return;\n   }\n  }\n  return {push:push,done:function(){return done;},end:function(){if(!headers||pending.length||chunked&&!done||expected!==null&&total!==expected)fail(\"flux incomplet.\");done=true;return {status:status,headers:headers,bytes:total};}};\n }\n g.JellyfinHttpStream={create:create};\n})(typeof window!==\"undefined\"?window:globalThis);\n"},{"name":"matroska.js","source":"/* Bounded incremental Matroska demux: AVC/Annex-B access units + stereo Opus.\n * No video/audio decoding in JS, no whole-file buffering, no remote code eval.\n */\n(function(g){\n \"use strict\";\n var masters={0x18538067:0,0x1549a966:1,0x1654ae6b:1,0xae:2,0xe0:3,0xe1:3,0x1f43b675:1,0xa0:2};\n var leaves={0x2ad7b1:1,0xd7:1,0x83:1,0x86:1,0x63a2:1,0x23e383:1,0xb0:1,0xba:1,0x54b0:1,0x54ba:1,0xb5:1,0x78b5:1,0x9f:1,0xe7:1,0xa3:1,0xa1:1,0xfb:1,0x6d80:1};\n function vint(bytes,at,id){\n  if(at>=bytes.length)return null;var first=bytes[at],mask=128,length=1;while(mask&&!(first&mask)){mask>>=1;length++;}\n  if(!mask||length>(id?4:8))throw Error(\"Matroska : entier EBML invalide.\");if(at+length>bytes.length)return null;\n  var value=id?first:first&(mask-1),unknown=!id&&(first&(mask-1))===mask-1;\n  for(var i=1;i<length;i++){value=value*256+bytes[at+i];unknown=unknown&&bytes[at+i]===255;}\n  if(!unknown&&!Number.isSafeInteger(value))throw Error(\"Matroska : taille EBML excessive.\");return {value:value,length:length,unknown:unknown};\n }\n function uint(a){if(!a.length||a.length>8)throw Error(\"Matroska : entier invalide.\");var n=0;for(var b of a)n=n*256+b;if(!Number.isSafeInteger(n))throw Error(\"Matroska : entier trop grand.\");return n;}\n function ascii(a){if(a.length>128)throw Error(\"Matroska : identifiant codec trop long.\");var s=\"\";for(var b of a){if(b<32||b>126)throw Error(\"Matroska : codec invalide.\");s+=String.fromCharCode(b);}return s;}\n function avc(a){\n  if(a.length<7||a[0]!==1)throw Error(\"Matroska : configuration H.264 AVC absente.\");\n  var lengthSize=(a[4]&3)+1,at=6,sps=null,pps=null,count=a[5]&31;\n  function nal(){if(at+2>a.length)throw Error(\"AVC : configuration incomplete.\");var n=a[at]*256+a[at+1];at+=2;if(!n||at+n>a.length||n>65536)throw Error(\"AVC : NAL de configuration invalide.\");var b=a.slice(at,at+n);at+=n;return b;}\n  for(var i=0;i<count;i++){var b=nal();if(!sps)sps=b;}\n  if(at>=a.length)throw Error(\"AVC : PPS absent.\");count=a[at++];for(var i=0;i<count;i++){var b=nal();if(!pps)pps=b;}\n  if(!sps||!pps||sps.length<4||(sps[0]&31)!==7||(pps[0]&31)!==8)throw Error(\"AVC : SPS/PPS invalides.\");\n  return {lengthSize:lengthSize,sps:sps,pps:pps};\n }\n function annex(a,size){var at=0,total=0,nals=[];while(at<a.length){if(at+size>a.length)throw Error(\"AVC : taille NAL incomplete.\");var n=0;for(var i=0;i<size;i++)n=n*256+a[at++];if(n<1||at+n>a.length)throw Error(\"AVC : NAL tronquee.\");nals.push(a.subarray(at,at+n));at+=n;total+=n+4;if(total>1048576||nals.length>1024)throw Error(\"AVC : image trop grande.\");}var out=new Uint8Array(total),p=0;for(var b of nals){out[p+3]=1;p+=4;out.set(b,p);p+=b.length;}return out;}\n function opusDuration(a){if(!a.length)throw Error(\"Opus : paquet vide.\");var config=a[0]>>3,code=a[0]&3,n=code===0?1:code===3?(a.length>1?a[1]&63:0):2;\n  var per=config>=16?2.5*Math.pow(2,config&3):config>=12?10*Math.pow(2,config&1):[10,20,40,60][config&3];\n  if(!n||n*per>120)throw Error(\"Opus : duree invalide.\");return n*per;\n }\n function splitBlock(a){\n  var t=vint(a,0,false);if(!t||t.unknown||t.value<1||t.value>255||t.length+3>a.length)throw Error(\"Matroska : bloc invalide.\");\n  var at=t.length,time=(a[at]<<8)|a[at+1];if(time&32768)time-=65536;var flags=a[at+2];at+=3;var lace=(flags>>1)&3,count=1,sizes=[];\n  if(lace){if(at>=a.length)throw Error(\"Matroska : lacing incomplet.\");count=a[at++]+1;\n   if(lace===1){for(var i=0;i<count-1;i++){var n=0,b;do{if(at>=a.length)throw Error(\"Matroska : lacing Xiph tronque.\");b=a[at++];n+=b;}while(b===255);sizes.push(n);}}\n   else if(lace===2){if((a.length-at)%count)throw Error(\"Matroska : lacing fixe invalide.\");for(var i=0;i<count-1;i++)sizes.push((a.length-at)/count);}\n   else if(count>1){var v=vint(a,at,false);if(!v||v.unknown)throw Error(\"Matroska : lacing EBML invalide.\");at+=v.length;sizes.push(v.value);for(var i=1;i<count-1;i++){var d=vint(a,at,false);if(!d||d.unknown)throw Error(\"Matroska : delta EBML invalide.\");at+=d.length;sizes.push(sizes[i-1]+d.value-(Math.pow(2,7*d.length-1)-1));}}\n  }\n  var used=sizes.reduce(function(s,n){return s+n;},0);sizes.push(a.length-at-used);var packets=[];\n  for(var n of sizes){if(!Number.isInteger(n)||n<1||n>1048576||at+n>a.length)throw Error(\"Matroska : bornes de trame invalides.\");packets.push(a.subarray(at,at+n));at+=n;}\n  if(at!==a.length)throw Error(\"Matroska : taille de bloc incoherente.\");return {track:t.value,time:time,key:!!(flags&128),packets:packets};\n }\n function create(o){\n  var buffer=new Uint8Array(0),pos=0,stack=[],skip=0,timeScale=1000000,clusterTime=0,current=null,tracks=[],selected=null,group=null,finished=false;\n  function ensureActive(){if(o.cancel&&o.cancel.cancelled)throw Error(\"Lecture annulee.\");}\n  async function emitBlock(a,key){\n   if(!selected)throw Error(\"Matroska : pistes absentes avant les images.\");var b=splitBlock(a),track=selected.video.number===b.track?selected.video:selected.audio&&selected.audio.number===b.track?selected.audio:null;if(!track)return;\n   var pts=(clusterTime+b.time)*timeScale/1000000;\n   for(var part of b.packets){ensureActive();var duration=track.type===2?opusDuration(part):track.defaultDuration?track.defaultDuration/1000000:1000/30;\n    var bytes=track.type===1?annex(part,track.avc.lengthSize):part.slice();\n    await o.onPacket({kind:track.type===1?\"video\":\"audio\",ptsMs:pts,durationMs:duration,keyframe:key===undefined?b.key:key,bytes:bytes});pts+=duration;\n   }\n  }\n  async function closeTop(){\n   var entry=stack.pop();\n   if(entry.id===0xae){if(current){if(tracks.length>=16||!Number.isInteger(current.number)||current.number<1||current.number>255||tracks.some(function(t){return t.number===current.number;}))throw Error(\"Matroska : numero/nombre de pistes invalide.\");tracks.push(current);current=null;}}\n   else if(entry.id===0x1654ae6b){\n    var video=tracks.find(function(t){return t.type===1&&t.codec===\"V_MPEG4/ISO/AVC\";}),audio=tracks.find(function(t){return t.type===2&&t.codec===\"A_OPUS\";});\n    if(!video||!Number.isInteger(video.number)||video.number<1||video.number>255||video.width<64||video.height<64||video.width>1920||video.height>1080)throw Error(\"Matroska : piste H.264/dimensions non prises en charge.\");\n    video.avc=avc(video.private||new Uint8Array(0));\n    if(audio&&(audio.channels!==2||audio.rate!==48000||!audio.private||audio.private.length<19||ascii(audio.private.subarray(0,8))!==\"OpusHead\"||audio.private[9]!==2||audio.private[18]!==0))throw Error(\"Matroska : seul Opus stereo 48 kHz sans mapping est accepte.\");\n    if(tracks.some(function(t){return t.type===2;})&&!audio)throw Error(\"Matroska : audio non Opus. Verifie le transcodage serveur.\");\n    selected={video:video,audio:audio||null};await o.onTracks(selected);\n   }else if(entry.id===0xa0){var b=group;group=null;if(b&&b.block)await emitBlock(b.block,!b.reference);}\n  }\n  async function leaf(id,a){\n   if(id===0x2ad7b1){timeScale=uint(a);if(timeScale<1||timeScale>1000000000)throw Error(\"Matroska : echelle de temps invalide.\");}\n   else if(id===0xe7)clusterTime=uint(a);\n   else if(id===0xa3)await emitBlock(a);\n   else if(id===0xa1){if(!group)throw Error(\"Matroska : Block hors groupe.\");if(group.block)throw Error(\"Matroska : plusieurs Block dans un groupe.\");group.block=a.slice();}\n   else if(id===0xfb){if(group)group.reference=true;}\n   else if(current){\n    if(id===0xd7)current.number=uint(a);else if(id===0x83)current.type=uint(a);else if(id===0x86)current.codec=ascii(a);else if(id===0x63a2){if(a.length>131072)throw Error(\"Matroska : configuration excessive.\");current.private=a.slice();}\n    else if(id===0xb0)current.width=uint(a);else if(id===0xba)current.height=uint(a);else if(id===0x54b0)current.displayWidth=uint(a);else if(id===0x54ba)current.displayHeight=uint(a);else if(id===0x9f)current.channels=uint(a);else if(id===0x23e383)current.defaultDuration=uint(a);\n    else if(id===0xb5||id===0x78b5){if(a.length!==4&&a.length!==8)throw Error(\"Matroska : frequence audio invalide.\");var dv=new DataView(a.buffer,a.byteOffset,a.byteLength);current.rate=a.length===4?dv.getFloat32(0,false):dv.getFloat64(0,false);}\n    else if(id===0x6d80)throw Error(\"Matroska : pistes compressees/chiffrees non prises en charge.\");\n   }\n  }\n  async function push(bytes){\n   ensureActive();if(finished||!(bytes instanceof Uint8Array)||bytes.length>65536)throw Error(\"Matroska : bloc d'entree invalide.\");\n   if(buffer.length+bytes.length>2162688)throw Error(\"Matroska : tampon d'entree depasse.\");var joined=new Uint8Array(buffer.length+bytes.length);joined.set(buffer);joined.set(bytes,buffer.length);buffer=joined;\n   var offset=0;\n   for(;;){\n    ensureActive();while(stack.length&&stack[stack.length-1].end!==null&&pos===stack[stack.length-1].end)await closeTop();\n    if(skip){var n=Math.min(skip,buffer.length-offset);offset+=n;pos+=n;skip-=n;if(skip)break;continue;}\n    var id=vint(buffer,offset,true);if(!id)break;var size=vint(buffer,offset+id.length,false);if(!size)break;\n    var header=id.length+size.length,master=Object.prototype.hasOwnProperty.call(masters,id.value);\n    if(master){var level=masters[id.value];while(stack.length&&stack[stack.length-1].end===null&&stack[stack.length-1].level>=level)await closeTop();}\n    if(size.unknown&&id.value!==0x18538067&&id.value!==0x1f43b675)throw Error(\"Matroska : taille inconnue non prise en charge.\");\n    var end=size.unknown?null:pos+header+size.value;\n    if(end!==null&&stack.some(function(s){return s.end!==null&&end>s.end;}))throw Error(\"Matroska : element 0x\"+id.value.toString(16)+\" hors parent a \"+pos+\".\");\n    if(master){\n     if(stack.length>=12)throw Error(\"Matroska : imbrication excessive.\");stack.push({id:id.value,end:end,level:masters[id.value]});offset+=header;pos+=header;\n     if(id.value===0xae){if(current)throw Error(\"Matroska : piste imbriquee.\");current={number:0,type:0,width:0,height:0,channels:0,rate:48000};}\n     if(id.value===0x1f43b675)clusterTime=0;\n     if(id.value===0xa0){if(group)throw Error(\"Matroska : groupe imbrique.\");group={block:null,reference:false};}\n    }else if(!leaves[id.value]){if(size.unknown)throw Error(\"Matroska : element inconnu non borne.\");offset+=header;pos+=header;skip=size.value;}\n    else{\n     if(size.value>2097152)throw Error(\"Matroska : element media excessif.\");if(offset+header+size.value>buffer.length)break;\n     await leaf(id.value,buffer.subarray(offset+header,offset+header+size.value));offset+=header+size.value;pos+=header+size.value;\n    }\n   }\n   buffer=buffer.slice(offset);\n  }\n  return {push:push,finish:async function(){await push(new Uint8Array(0));if(buffer.length||skip||stack.some(function(s){return s.end!==null&&s.end!==pos;}))throw Error(\"Matroska : fin de flux incomplete.\");while(stack.length)await closeTop();if(!selected)throw Error(\"Matroska : aucune piste lisible.\");finished=true;},stats:function(){return {bufferBytes:buffer.length,position:pos,tracks:tracks.length};}};\n }\n g.JellyfinMatroska={create:create,avc:avc,annex:annex,opusDuration:opusDuration,splitBlock:splitBlock};\n})(typeof window!==\"undefined\"?window:globalThis);\n"},{"name":"native-http.js","source":"/* HTTP socket adapter, using the SDK ABI already used by CivHomebrew's\n * app/src/platform/{native,https-native}.js. No hard-coded symbol addresses.\n * HTTP only: HTTPS is explicitly rejected, never downgraded.\n */\n(function (g) {\n    \"use strict\";\n    var prefix = \"_ZN2nn6socket\";\n    function bridge() {\n        if (typeof sdk_base === \"undefined\" || typeof call_rop !== \"function\" ||\n            typeof malloc !== \"function\" || typeof free !== \"function\" ||\n            typeof read_buffer !== \"function\" || typeof write_buffer !== \"function\") throw Error(\"Pont natif CivSwitch indisponible.\");\n        var cache = {}, mod = sdk_base + read32(sdk_base + 4n);\n        if (read32(mod) !== 0x30444f4dn) throw Error(\"Module SDK non reconnu.\");\n        var dyn = mod + BigInt.asIntN(32,read32(mod + 4n)), tags = {};\n        for (var i=0;i<128;i++) {\n            var tag = Number(read64(dyn + BigInt(i*16))); if (!tag) break;\n            var value = read64(dyn + BigInt(i*16+8)); tags[tag] = value < sdk_base ? sdk_base + value : value;\n        }\n        if (!tags[4] || !tags[5] || !tags[6]) throw Error(\"Table SDK absente.\");\n        var buckets = Number(read32(tags[4])), count = Number(read32(tags[4]+4n));\n        if (buckets<1 || buckets>1000000 || count<1 || count>1000000) throw Error(\"Bornes SDK invalides.\");\n        function resolve(name) {\n            if (cache[name]) return cache[name];\n            var hash=0;\n            for(var i=0;i<name.length;i++){hash=((hash<<4)+name.charCodeAt(i))>>>0;var hi=hash&0xf0000000;if(hi)hash^=hi>>>24;hash=(hash&~hi)>>>0;}\n            var index=Number(read32(tags[4]+8n+BigInt(hash%buckets*4)));\n            for(var step=0;index&&step<count;step++) {\n                if(index>=count)throw Error(\"Chaine SDK invalide.\");\n                var entry=tags[6]+BigInt(index*24),p=tags[5]+read32(entry),s=\"\";\n                for(var j=0;j<512;j++){var c=Number(read8(p+BigInt(j)));if(!c)break;s+=String.fromCharCode(c);}\n                if(s===name){var off=read64(entry+8n);if(off)return cache[name]=sdk_base+off;break;}\n                index=Number(read32(tags[4]+8n+BigInt((buckets+index)*4)));\n            }\n            throw Error(\"Export SDK absent : \"+name);\n        }\n        // Resolve everything before opening sockets or allocating request buffers.\n        [\"6SocketEiii\",\"5CloseEi\",\"5FcntlEiiz\",\"7ConnectEiPK8sockaddrj\",\"4SendEiPKvmi\",\"4RecvEiPvmi\",\"12GetLastErrnoEv\"].forEach(function(n){resolve(prefix+n);});\n        resolve(\"_ZN2nn4nifm22GetCurrentIpConfigInfoEPNS_6socket6InAddrES3_S3_S3_S3_\");\n        resolve(\"_ZN2nn6crypto36GenerateCryptographicallyRandomBytesEPvm\");\n        var transfer=null;\n        if(g.PayloadNativeBuffer&&typeof addrof_compressed===\"function\"&&typeof read64_compressed===\"function\"&&typeof read32_compressed===\"function\"&&typeof memcpy_addr===\"bigint\")\n            transfer=g.PayloadNativeBuffer.create({addrof:addrof_compressed,read64:read64_compressed,read32:read32_compressed,read8:read8,call:call_rop,memcpy:memcpy_addr});\n        return {\n            resolve:resolve,\n            call:function(name){return call_rop.apply(null,[resolve(name)].concat(Array.prototype.slice.call(arguments,1).map(BigInt)));},\n            alloc:malloc,free:free,\n            put:function(p,s){if(transfer)return transfer.write(p,s);var a=new Uint8Array(s.length);for(var i=0;i<s.length;i++)a[i]=s.charCodeAt(i);write_buffer(p,a);},\n            get:function(p,n){if(transfer)return transfer.read(p,n);var a=read_buffer(p,n),s=\"\";for(var i=0;i<n;i++)s+=String.fromCharCode(Number(a[i]));return s;}\n        };\n    }\n    function target(url) {\n        var m=/^http:\\/\\/([a-z0-9.-]+)(?::([0-9]{1,5}))?(\\/[^\\s#]*)?$/i.exec(url);\n        if(!m)throw Error(\"Mode natif : adresse HTTP uniquement, sans identifiants ni fragment.\");\n        var port=Number(m[2]||80);if(port<1||port>65535)throw Error(\"Port HTTP invalide.\");\n        return {host:m[1].toLowerCase(),port:port,path:m[3]||\"/\",authority:m[1]+(m[2]?\":\"+m[2]:\"\")};\n    }\n    function encode(s){return encodeURIComponent(s).replace(/%([0-9a-f]{2})/gi,function(_,h){return String.fromCharCode(parseInt(h,16));});}\n    function decode(s){return decodeURIComponent(s.replace(/[%\\x80-\\xff]/g,function(c){return \"%\"+c.charCodeAt(0).toString(16).padStart(2,\"0\");}));}\n    function create(injected) {\n        if(!g.CivHttp||!g.CivDns)throw Error(\"Modules HTTP/DNS de CivHomebrew absents.\");\n        var b=injected||bridge(),addresses={};\n        function call(){return b.call.apply(null,arguments);}\n        function sock(name){return Number(BigInt.asIntN(32,call.apply(null,[prefix+name].concat(Array.prototype.slice.call(arguments,1)))));}\n        function retry(){return [11,35,4].indexOf(sock(\"12GetLastErrnoEv\"))>=0;}\n        function checked(){var r=Number(call.apply(null,arguments)&0x3fffffn);if(r)throw Error(\"Erreur SDK 0x\"+r.toString(16));}\n        function active(o){if(o.cancel.cancelled)throw Error(\"Requete annulee.\");if(Date.now()>=o.deadline)throw Error(\"Delai reseau natif depasse.\");}\n        function pause(){return new Promise(function(r){setTimeout(r,10);});}\n        function take(list,n){var p=b.alloc(n);if(!p)throw Error(\"Allocation native impossible.\");list.push(p);return p;}\n        function nonblock(fd){var flags=sock(\"5FcntlEiiz\",fd,3,0);if(flags<0||sock(\"5FcntlEiiz\",fd,4,flags|0x800)<0)throw Error(\"Mode non bloquant impossible.\");}\n        function ip(value){var a=value.split(\".\").map(Number);return a.length===4&&a.every(function(n){return Number.isInteger(n)&&n>=0&&n<=255;});}\n        function address(p,value,port){if(!ip(value))throw Error(\"IPv4 invalide.\");b.put(p,String.fromCharCode.apply(null,[16,2,port>>>8,port&255].concat(value.split(\".\").map(Number),[0,0,0,0,0,0,0,0])));}\n        async function dns(host,o,depth) {\n            active(o);if(ip(host))return host;\n            if(addresses[host]&&addresses[host].expires>Date.now())return addresses[host].ip;\n            if(depth>5)throw Error(\"Limite alias DNS.\");\n            var list=[],fd=-1;\n            try {\n                var config=take(list,40);b.put(config,\"\\0\".repeat(40));\n                checked(\"_ZN2nn4nifm22GetCurrentIpConfigInfoEPNS_6socket6InAddrES3_S3_S3_S3_\",config,config+8n,config+16n,config+24n,config+32n);\n                var servers=[b.get(config+24n,4),b.get(config+32n,4)].map(function(s){return s.split(\"\").map(function(c){return c.charCodeAt(0);}).join(\".\");}).filter(function(s,i,a){return s!==\"0.0.0.0\"&&a.indexOf(s)===i;});\n                if(!servers.length)throw Error(\"Aucun serveur DNS configure.\");\n                var seed=take(list,2);call(\"_ZN2nn6crypto36GenerateCryptographicallyRandomBytesEPvm\",seed,2);\n                var bytes=b.get(seed,2),id=bytes.charCodeAt(0)*256+bytes.charCodeAt(1),packet=g.CivDns.query(host,id);\n                var wire=take(list,packet.length),buffer=take(list,4096),peer=take(list,16);b.put(wire,packet);\n                for(var i=0;i<servers.length;i++) {\n                    fd=sock(\"6SocketEiii\",2,2,0);if(fd<0)throw Error(\"Socket DNS impossible.\");\n                    nonblock(fd);address(peer,servers[i],53);if(sock(\"7ConnectEiPK8sockaddrj\",fd,peer,16)<0)throw Error(\"Connexion DNS impossible.\");\n                    var expires=Math.min(o.deadline,Date.now()+4000),sent=false;\n                    while(Date.now()<expires) {\n                        active(o);\n                        if(!sent){var n=sock(\"4SendEiPKvmi\",fd,wire,packet.length,0x80);if(n===packet.length)sent=true;else if(n>=0||!retry())throw Error(\"Envoi DNS impossible.\");}\n                        var n=sock(\"4RecvEiPvmi\",fd,buffer,4096,0x80);\n                        if(n>0){var reply=g.CivDns.parse(b.get(buffer,n),host,id);sock(\"5CloseEi\",fd);fd=-1;var value=reply.address||await dns(reply.alias,o,depth+1);addresses[host]={ip:value,expires:Date.now()+60000};return value;}\n                        if(n<0&&!retry())throw Error(\"Reception DNS impossible.\");await pause();\n                    }\n                    sock(\"5CloseEi\",fd);fd=-1;\n                }\n                throw Error(\"Resolution DNS sans reponse.\");\n            } finally {try{if(fd>=0)sock(\"5CloseEi\",fd);}finally{list.reverse().forEach(b.free);}}\n        }\n        async function exchange(url,method,headers,body,o) {\n            var t=target(url),resolved=await dns(t.host,o,0),list=[],fd=-1;\n            try {\n                active(o);var peer=take(list,16),buffer=take(list,16384);address(peer,resolved,t.port);\n                fd=sock(\"6SocketEiii\",2,1,0);if(fd<0)throw Error(\"Socket HTTP impossible.\");nonblock(fd);\n                for(;;){active(o);var result=sock(\"7ConnectEiPK8sockaddrj\",fd,peer,16);if(result===0)break;var errno=sock(\"12GetLastErrnoEv\");if(errno===106||errno===56)break;if([115,114,36,37,11,35,4].indexOf(errno)<0)throw Error(\"Connexion HTTP impossible (errno \"+errno+\").\");await pause();}\n                if(method!==\"GET\"&&method!==\"POST\")throw Error(\"Methode HTTP non prise en charge.\");\n                var payload=body===null?\"\":encode(body),wire=method+\" \"+t.path+\" HTTP/1.1\\r\\nHost: \"+t.authority+\"\\r\\nConnection: close\\r\\nAccept-Encoding: identity\\r\\n\";\n                Object.keys(headers).forEach(function(k){if(!/^[A-Za-z-]+$/.test(k)||/[^\\x20-\\x7e]/.test(headers[k]))throw Error(\"En-tete invalide.\");wire+=k+\": \"+headers[k]+\"\\r\\n\";});\n                if(body!==null)wire+=\"Content-Length: \"+payload.length+\"\\r\\n\";\n                wire+=\"\\r\\n\"+payload;\n                for(var offset=0;offset<wire.length;){active(o);var part=wire.slice(offset,offset+16384);b.put(buffer,part);var n=sock(\"4SendEiPKvmi\",fd,buffer,part.length,0x80);if(n>part.length)throw Error(\"Bornes envoi invalides.\");if(n>0)offset+=n;else if(n===0||!retry())throw Error(\"Envoi HTTP interrompu.\");await pause();}\n                var reader=g.CivHttp.reader(2097152),batch=0;\n                while(!reader.done()) {\n                    active(o);var n=sock(\"4RecvEiPvmi\",fd,buffer,16384,0x80);\n                    if(n>16384)throw Error(\"Bornes reception invalides.\");\n                    if(n>0){reader.push(b.get(buffer,n));batch+=n;if(batch>=65536){batch=0;await pause();}}\n                    else if(n===0)break;else {if(!retry())throw Error(\"Reception HTTP interrompue.\");await pause();}\n                }\n                var response=reader.end();response.body=decode(response.body);return response;\n            } finally {try{if(fd>=0)sock(\"5CloseEi\",fd);}finally{list.reverse().forEach(b.free);}}\n        }\n        exchange.stream=async function(url,headers,o){\n            if(!g.JellyfinHttpStream||typeof o.onData!==\"function\")throw Error(\"Adaptateur de flux absent.\");\n            var idle=o.idleTimeoutMs||30000;if(!Number.isInteger(idle)||idle<1000||idle>120000)throw Error(\"Delai de flux invalide.\");\n            o.deadline=Date.now()+idle;var t=target(url),resolved=await dns(t.host,o,0),list=[],fd=-1;\n            try{\n                active(o);var peer=take(list,16),buffer=take(list,65536);address(peer,resolved,t.port);\n                fd=sock(\"6SocketEiii\",2,1,0);if(fd<0)throw Error(\"Socket video impossible.\");nonblock(fd);\n                for(;;){active(o);var result=sock(\"7ConnectEiPK8sockaddrj\",fd,peer,16);if(result===0)break;var errno=sock(\"12GetLastErrnoEv\");if(errno===106||errno===56)break;if([115,114,36,37,11,35,4].indexOf(errno)<0)throw Error(\"Connexion video impossible (errno \"+errno+\").\");await pause();}\n                var wire=\"GET \"+t.path+\" HTTP/1.1\\r\\nHost: \"+t.authority+\"\\r\\nConnection: close\\r\\nAccept-Encoding: identity\\r\\n\";\n                Object.keys(headers).forEach(function(k){if(!/^[A-Za-z-]+$/.test(k)||/[\\x00-\\x1f\\x7f-\\uffff]/.test(headers[k])||/^(host|connection|content-length|transfer-encoding|accept-encoding)$/i.test(k))throw Error(\"En-tete de flux invalide.\");wire+=k+\": \"+headers[k]+\"\\r\\n\";});wire+=\"\\r\\n\";\n                if(wire.length>65536)throw Error(\"Requete video trop grande.\");b.put(buffer,wire);\n                for(var offset=0;offset<wire.length;){active(o);var n=sock(\"4SendEiPKvmi\",fd,buffer+BigInt(offset),wire.length-offset,0x80);if(n>wire.length-offset)throw Error(\"Bornes envoi video.\");if(n>0)offset+=n;else if(n===0||!retry())throw Error(\"Envoi video interrompu.\");await pause();}\n                var framing=g.JellyfinHttpStream.create(o),batch=0;\n                while(!framing.done()){\n                    active(o);var n=sock(\"4RecvEiPvmi\",fd,buffer,65536,0x80);if(n>65536)throw Error(\"Bornes reception video.\");\n                    if(n>0){await framing.push(b.get(buffer,n));o.deadline=Date.now()+idle;batch+=n;if(batch>=65536){batch=0;await new Promise(function(r){setTimeout(r,0);});}}\n                    else if(n===0)break;else{if(!retry())throw Error(\"Reception video interrompue.\");await pause();}\n                }\n                active(o);return framing.end();\n            }finally{try{if(fd>=0)sock(\"5CloseEi\",fd);}finally{list.reverse().forEach(b.free);}}\n        };\n        return exchange;\n    }\n    g.JellyfinNativeHttp={available:typeof sdk_base!==\"undefined\"&&typeof call_rop===\"function\",create:create,bridge:bridge,target:target};\n})(typeof window!==\"undefined\"?window:globalThis);\n"},{"name":"vod-pacer.js","source":"/* Presentation-time output queue. Retain bounded decoded frames rather than\n * Moonlight's live-stream policy of always selecting the newest available one.\n */\n(function(g){\n \"use strict\";\n function create(o){\n  var queue=[],last=null,closed=false;\n  function releaseAll(){var failure=null;while(queue.length){var f=queue.shift();try{last.release(f);}catch(e){if(!failure)failure=e;}}if(failure)throw failure;}\n  return {pending:function(){return queue.length;},close:function(){if(closed)return;closed=true;releaseAll();},drain:function(options){\n   if(closed)throw Error(\"File de presentation fermee.\");last=options;\n   try{\n    for(var i=0;i<8&&queue.length<4;i++){\n     var f=options.acquire();if(!f)break;\n     if(queue.some(function(x){return x.index===f.index;}))throw Error(\"Slot video acquis deux fois.\");\n     queue.push(f);options.decoded(f);\n     if(!f.displayable){queue.pop();options.release(f);}\n    }\n    queue.sort(function(a,b){return a.timestamp-b.timestamp;});\n    if(!queue.length||o.paused())return;\n    var now=o.clock();\n    // Keep reference decoding intact; skip only already-decoded display frames\n    // after a real stall, never as the normal steady-state VOD policy.\n    while(queue.length>1&&o.targetAt(queue[1].timestamp)<now-125){options.release(queue.shift());options.superseded(\"late\");}\n    var target=o.targetAt(queue[0].timestamp);\n    if(!Number.isFinite(target)||target-now>60000)throw Error(\"Horodatage video natif incoherent.\");\n    if(target>now+8)return;\n    var frame=queue.shift(),owned=true;\n    try{options.present(frame,function(){owned=false;});}finally{if(owned)options.release(frame);}\n   }catch(e){try{releaseAll();}catch(_){}throw e;}\n  }};\n }\n g.JellyfinVodPacer={create:create};\n})(typeof window!==\"undefined\"?window:globalThis);\n"},{"name":"native-player.js","source":"/* Jellyfin transport/demux/clock around Moonlight-CivSwitch's native media path.\n * No HTML video, VFS alias, Sunshine server, generated Moonlight protocol core,\n * executable patch or whole-film download. VOD timing uses a small derived adapter.\n */\n(function(g){\n \"use strict\";\n function create(options){\n  var o=options||{},cancel={cancelled:false},queue=[],queueBytes=0,io=null,media=null,heap=null,networkTask=null,networkError=null,eof=false,tracks=null;\n  var firstPts=null,origin=null,paused=false,pauseAt=0,tailAt=null,lastStats=0,closed=false,failed=null;\n  var frameWait=null;\n  var buffering=true,bufferAt=null,lastVideo=null,lastAudio=null,saturated=false;\n  var maxBytes=16777216,maxPackets=4096,maxAhead=20000;\n  var deps=o.dependencies||{},clock=deps.clock||function(){return g.performance&&g.performance.now?g.performance.now():Date.now();};\n  function sleep(ms){return new Promise(function(r){setTimeout(r,ms);});}\n  function active(){if(cancel.cancelled)throw Error(\"Lecture native arretee.\");}\n  function status(s){if(o.onStatus&&!cancel.cancelled)o.onStatus(s);}\n  function mediaDeadline(){return (g.MoonlightTelemetry&&g.MoonlightTelemetry.now?g.MoonlightTelemetry.now():Date.now())+1;}\n  function playClock(){return paused?pauseAt:buffering&&bufferAt!==null?bufferAt:clock();}\n  function seconds(){return origin===null?0:Math.max(0,(playClock()-origin)/1000);}\n  function ahead(){if(firstPts===null)return 0;var end=lastVideo;if(tracks&&tracks.audio)end=end===null?null:Math.min(end,lastAudio===null?firstPts:lastAudio);return end===null?0:Math.max(0,end-firstPts-seconds()*1000);}\n  function notifyBuffer(){if(o.onBuffer&&!cancel.cancelled)o.onBuffer({buffering:buffering,bufferedSeconds:ahead()/1000,paused:paused});}\n  function targetAt(timestamp){return buffering||origin===null||firstPts===null?Infinity:origin+timestamp/1000-firstPts;}\n  function wakeFrame(){if(frameWait)frameWait.finish();}\n  function nextFrame(service){return new Promise(function(resolve){\n   var wait={raf:null,timer:null,service:null,finish:function(){\n    if(frameWait!==wait)return;frameWait=null;clearTimeout(wait.timer);clearTimeout(wait.service);\n    if(wait.raf!==null&&typeof g.cancelAnimationFrame===\"function\")g.cancelAnimationFrame(wait.raf);resolve();\n   }};frameWait=wait;\n   var raf=typeof g.requestAnimationFrame===\"function\"&&typeof g.cancelAnimationFrame===\"function\";\n   wait.timer=setTimeout(wait.finish,raf?50:8);\n   wait.service=setTimeout(function(){if(frameWait!==wait||cancel.cancelled)return;try{service();}catch(e){networkError=e;wait.finish();}},4);\n   if(raf)wait.raf=g.requestAnimationFrame(wait.finish);\n  });}\n  var finished=(async function(){\n   await Promise.resolve(); // Return the controller before invoking any UI callbacks.\n   try{\n    if(g.__jellyfinNativeQuarantine)throw Error(\"Un lecteur natif precedent n'a pas pu etre libere. Redemarre Civilization VII.\");\n    var exchange;\n    if(deps.exchange){exchange=deps.exchange;io=deps.io;media=deps.media;}\n    else{\n     if(!g.JellyfinNativeHttp||!g.JellyfinNativeHttp.available||!g.MoonlightStreamIO||!g.MoonlightStreamMedia||!g.MoonlightNativeTexture)throw Error(\"Composants du lecteur natif absents.\");\n     var bridge=g.JellyfinNativeHttp.bridge();\n     io=g.MoonlightStreamIO.create({resolveNativeSymbol:bridge.resolve},{batchReceive:false});\n     exchange=g.JellyfinNativeHttp.create(bridge);\n    }\n    heap=new Uint8Array(4194304);\n    var core={HEAPU8:heap,_malloc:function(){throw Error(\"Allocation CPU inattendue : lecteur GPU uniquement.\");},_free:function(){throw Error(\"Liberation CPU inattendue.\");},_ml_png_release:function(){}};\n    if(!media){\n     if(!g.JellyfinVodPacer)throw Error(\"Ordonnanceur VOD absent du paquet.\");\n      media=g.MoonlightStreamMedia.create(io,core,{smoothVideo:false,videoPacer:g.JellyfinVodPacer.create({clock:clock,targetAt:targetAt,paused:function(){return paused||buffering;}}),presentationDue:function(timestamp){return !paused&&!buffering&&clock()>=targetAt(timestamp);},onImage:function(url){if(!cancel.cancelled&&o.onImage)o.onImage(url);},onStatus:status});\n    }\n    var videoPointer=0x1000,spsPointer=0x110000,ppsPointer=0x120000,audioPointer=0x130000;\n    var demux=g.JellyfinMatroska.create({cancel:cancel,onTracks:async function(t){\n     active();if(tracks)throw Error(\"Changement de pistes en cours de lecture non pris en charge.\");tracks=t;\n     var fps=t.video.defaultDuration?Math.round(1000000000/t.video.defaultDuration):30;fps=Math.max(1,Math.min(60,fps));\n     status(\"Initialisation du decodeur materiel H.264 et de la texture GPU...\");\n     media.videoSetup(1,t.video.width,t.video.height,fps);\n     heap.set(t.video.avc.sps,spsPointer);heap.set(t.video.avc.pps,ppsPointer);\n     if(t.audio)media.audioSetup(48000,2,1,1,960);\n     if(o.onFormat)o.onFormat({width:t.video.width,height:t.video.height,displayWidth:t.video.displayWidth||t.video.width,displayHeight:t.video.displayHeight||t.video.height});\n     status(\"Reception native H.264\"+(t.audio?\" + Opus stereo\":\" (sans piste audio)\")+\"...\");\n    },onPacket:async function(packet){\n     active();var limit=packet.kind===\"video\"?1048576:65536;\n     if(packet.bytes.length<1||packet.bytes.length>limit||!Number.isFinite(packet.ptsMs))throw Error(\"Paquet media natif hors limites.\");\n      while(queueBytes+packet.bytes.length>maxBytes||queue.length>=maxPackets||ahead()>=maxAhead){saturated=true;active();if(networkError)throw networkError;await sleep(5);}\n      saturated=false;\n      active();if(firstPts===null)firstPts=packet.ptsMs;\n     // The baseline transcoding request avoids reordered B frames. Sorting also\n     // handles small A/V interleave differences without unbounded packet retention.\n     var at=queue.length;while(at&&queue[at-1].ptsMs>packet.ptsMs)at--;\n      queue.splice(at,0,packet);queueBytes+=packet.bytes.length;\n      if(packet.kind===\"video\")lastVideo=packet.ptsMs;else lastAudio=packet.ptsMs;\n    }});\n    function feed(audioOnly,budget){\n      if(paused||buffering||origin===null||!tracks)return;\n     var elapsed=clock()-origin,deadline=clock()+budget,turns=0,videoBlocked=audioOnly;\n     while(queue.length&&turns++<12&&clock()<deadline){\n      var index=queue.findIndex(function(p){return (!videoBlocked||p.kind===\"audio\")&&p.ptsMs-firstPts<=elapsed+(p.kind===\"video\"?80:0);});\n      if(index<0)break;var packet=queue[index];\n      if(packet.kind===\"video\"){\n       heap.set(packet.bytes,videoPointer);\n       var result=media.videoFrame(videoPointer,packet.bytes.length,packet.keyframe?1:2,Math.round(packet.ptsMs*1000),spsPointer,tracks.video.avc.sps.length,ppsPointer,tracks.video.avc.pps.length,heap);\n       if(result!==0){videoBlocked=true;continue;} // Busy video must not prevent timely audio.\n      }else{heap.set(packet.bytes,audioPointer);media.audioFrame(audioPointer,packet.bytes.length,heap);}\n      queue.splice(index,1);queueBytes-=packet.bytes.length;\n     }\n    }\n    networkTask=(async function(){\n     try{\n      await exchange.stream(o.url,o.headers||{}, {cancel:cancel,idleTimeoutMs:30000,onHeaders:async function(_,headers){\n       var type=(headers[\"content-type\"]||\"\").toLowerCase();\n       if(type.indexOf(\"html\")>=0||type.indexOf(\"json\")>=0)throw Error(\"Le serveur n'a pas renvoye un flux Matroska video.\");\n       status(\"Flux HTTP natif ouvert. Analyse des pistes Matroska...\");\n      },onData:demux.push});\n      if(!cancel.cancelled)await demux.finish();\n     }catch(e){if(!cancel.cancelled)networkError=e;}\n     finally{eof=true;}\n    })();\n    while(!cancel.cancelled){\n     if(networkError)throw networkError;\n      if(tracks){\n       if(buffering&&!paused&&(ahead()>=(origin===null?2500:3000)||eof||saturated)&&queue.length){\n        if(origin===null)origin=clock()+80;else origin+=clock()-bufferAt;\n        buffering=false;bufferAt=null;notifyBuffer();\n       }\n       if(!buffering&&!paused&&!eof&&origin!==null&&clock()>origin&&ahead()<100&&media.stats().audioBufferedMsUpperBound<=40){\n        buffering=true;bufferAt=clock();notifyBuffer();\n       }\n      media.drainVideo();media.finishVideo(mediaDeadline());media.drainAudio();\n      feed(false,4);\n      media.finishVideo(mediaDeadline());media.drainAudio();\n       if(o.onStats&&clock()-lastStats>=1000){lastStats=clock();o.onStats(Object.assign({queuedPackets:queue.length,queuedBytes:queueBytes,seconds:seconds(),paused:paused,buffering:buffering,bufferedSeconds:ahead()/1000},media.stats()));notifyBuffer();}\n      if(eof&&!queue.length&&!paused){if(tailAt===null)tailAt=clock();var s=media.stats();if(clock()-tailAt>150&&(s.decoderPending===0&&s.audioBufferedMsUpperBound<20||clock()-tailAt>1500))break;}\n     }else if(eof)throw Error(\"Le flux n'a fourni aucune piste H.264 exploitable.\");\n      await nextFrame(function(){if(tracks){media.drainAudio();feed(true,1);media.drainAudio();}});\n    }\n   }catch(e){if(!cancel.cancelled)failed=e;}\n   finally{\n    cancel.cancelled=true;wakeFrame();\n    if(networkTask)await networkTask;\n    queue=[];queueBytes=0;\n    if(media){\n     var releaseDeadline=clock()+1000,released=false;\n     for(var tries=0;tries<200;tries++){\n      try{media.close();released=true;break;}\n      catch(e){if(!/GPU transfer is still pending/.test(e.message)||clock()>=releaseDeadline){failed=e;break;}await sleep(5);}\n     }\n     if(!released){g.__jellyfinNativeQuarantine={media:media,io:io,heap:heap};failed=Error(\"Liberation GPU non confirmee : ressources conservees pour securite. Redemarre Civilization VII.\");}\n    }\n    if(!g.__jellyfinNativeQuarantine&&io){try{io.close();}catch(e){failed=e;g.__jellyfinNativeQuarantine={io:io,heap:heap};}}\n    if(!g.__jellyfinNativeQuarantine){heap=null;media=null;io=null;}closed=true;\n   }\n   if(failed){if(o.onError)o.onError(failed.message);return {ok:false,error:failed.message};}\n   if(o.onEnded)o.onEnded();return {ok:true};\n  })();\n  return {finished:finished,stop:function(){cancel.cancelled=true;wakeFrame();return finished;},togglePause:function(){if(closed||cancel.cancelled)return false;if(paused){if(origin!==null&&!buffering)origin+=clock()-pauseAt;paused=false;}else{pauseAt=playClock();paused=true;}notifyBuffer();return paused;},stats:function(){return {seconds:seconds(),queuedBytes:queueBytes,queuedPackets:queue.length,bufferedSeconds:ahead()/1000,buffering:buffering,paused:paused,closed:closed};}};\n }\n g.JellyfinNativePlayer={create:create};\n})(typeof window!==\"undefined\"?window:globalThis);\n"},{"name":"player-layout.js","source":"/* Pure letterbox/pillarbox geometry in the current Gameface viewport's CSS pixels.\n * Use display dimensions (when supplied) to honour pixel aspect ratio as well.\n */\n(function(g){\n \"use strict\";\n function positive(n){return Number.isFinite(n)&&n>0&&n<=32768;}\n function fit(viewWidth,viewHeight,videoWidth,videoHeight){\n  var w=positive(viewWidth)?Math.max(1,Math.floor(viewWidth)):1280;\n  var h=positive(viewHeight)?Math.max(1,Math.floor(viewHeight)):720;\n  var valid=positive(videoWidth)&&positive(videoHeight),vw=valid?videoWidth:16,vh=valid?videoHeight:9;\n  var scale=Math.min(w/vw,h/vh);\n  var width=Math.max(1,Math.min(w,Math.floor(vw*scale))),height=Math.max(1,Math.min(h,Math.floor(vh*scale)));\n  return {left:Math.floor((w-width)/2),top:Math.floor((h-height)/2),width:width,height:height};\n }\n g.JellyfinPlayerLayout={fit:fit};\n})(typeof window!==\"undefined\"?window:globalThis);\n"},{"name":"playback-options.js","source":"/* Pure media timeline and Jellyfin subtitle selection helpers. */\n(function(g){\n \"use strict\";\n function duration(item,source){var ticks=Number(source&&source.RunTimeTicks)||Number(item&&item.RunTimeTicks);return Number.isFinite(ticks)&&ticks>0?ticks/10000000:null;}\n function clamp(seconds,length){seconds=Number(seconds);if(!Number.isFinite(seconds))seconds=0;return Math.max(0,length?Math.min(seconds,Math.max(0,length-1)):seconds);}\n function subtitles(source){return (source.MediaStreams||[]).filter(function(s){return s.Type===\"Subtitle\"&&Number.isInteger(s.Index)&&s.Index>=0;}).map(function(s){return {index:s.Index,label:s.DisplayTitle||[s.Title,s.Language,s.Codec,s.IsForced?\"Force\":\"\"].filter(Boolean).join(\" \u00b7 \")||\"Piste \"+s.Index};});}\n function time(seconds){seconds=Math.floor(Math.max(0,Number(seconds)||0));var h=Math.floor(seconds/3600),m=Math.floor(seconds/60)%60,s=seconds%60;return (h?h+\":\"+(m<10?\"0\":\"\"):\"\")+m+\":\"+(s<10?\"0\":\"\")+s;}\n function streamOptions(offset,subtitle){return {StartTimeTicks:Math.round(Math.max(0,offset)*10000000),SubtitleStreamIndex:subtitle===null?-1:subtitle,SubtitleMethod:subtitle===null?\"Drop\":\"Encode\"};}\n g.JellyfinPlaybackOptions={duration:duration,clamp:clamp,subtitles:subtitles,time:time,streamOptions:streamOptions};\n})(typeof window!==\"undefined\"?window:globalThis);\n"},{"name":"app.js","source":"/* Jellyfin 0.0.1 by SaoriYuki. Credentials persist only with explicit consent. */\n(async function () {\n    \"use strict\";\n    var previous = window.__civswitchApp;\n    if (previous && typeof previous.close === \"function\") await previous.close();\n    var id = \"jellyfin-civswitch\", closed = false, busy = false, editing = false;\n    var font = \"BodyFont, BodyFont-JP, BodyFont-KR, BodyFont-SC, BodyFont-TC, Arial, sans-serif\";\n    var server = \"\", accepted = false, serverName = \"\", username = \"\", password = \"\", token = \"\", userId = \"\";\n    var settingsPath = \"save:/civhomebrew/jellyfin-settings.json\", storage = null, storageTask = null, browserEditor = null;\n    var rememberCredentials=false, savedCredentials=null;\n    var deviceId = \"civswitch-\" + Date.now().toString(36) + Math.random().toString(36).slice(2);\n    var resolveLifetime, lifetime = new Promise(function (resolve) { resolveLifetime = resolve; });\n    var selected = 0, controls = [], requests = [], subscriptions = [], frame = null;\n    var stack = [], page = null, view = \"login\", last = {name:\"\",time:0}, held = \"\", nextRepeat = 0;\n    var owner = {owner:id}, nativeInput = false, padStates = {}, keyboard = null;\n    var transport = window.JellyfinNativeHttp && window.JellyfinNativeHttp.available ? \"Natif\" : \"XHR\";\n    var nativeExchange = null;\n    var firstVisible = 0, paging = null;\n    var activePlayback = null, cleanupTasks = [];\n    var nativePlayer = null, nativeImage = null;\n    var fullscreenLayer = null, fullscreenNotice = null, fullscreenState = null, nativeFormat = {width:16,height:9};\n    var playbackOptions=window.JellyfinPlaybackOptions, playback=null, playGeneration=0;\n    var playerHud=null,playerTime=null,playerProgress=null,hudTimer=null,seekTimer=null,seekTarget=null,subtitleMenu=null,subtitleSelection=0;\n    function node(tag, parent, style, text) {\n        var n = document.createElement(tag);\n        // Gameface does not reliably resolve inherited fonts on form controls.\n        Object.assign(n.style, {fontFamily:font,fontWeight:\"400\",fontStyle:\"normal\"}, style || {});\n        if (text !== undefined) n.textContent = text;\n        parent.appendChild(n);\n        return n;\n    }\n    var root = node(\"div\", document.body, {position:\"fixed\",left:\"0\",right:\"0\",top:\"0\",bottom:\"0\",backgroundColor:\"#090d18\",backgroundImage:\"linear-gradient(125deg,#19132d,#090d18 65%,#082535)\",color:\"#fff\",zIndex:\"2\",padding:\"32px 64px\",boxSizing:\"border-box\",display:\"flex\",flexDirection:\"column\",outline:\"none\"});\n    root.id = id; root.tabIndex = -1;\n    var heading = node(\"div\", root, {display:\"flex\",alignItems:\"center\",height:\"64px\",marginBottom:\"20px\"});\n    node(\"img\",heading,{width:\"48px\",height:\"48px\",marginRight:\"16px\"}).src=window.JellyfinBrand.icon;\n    node(\"span\",heading,{fontSize:\"34px\",color:\"#fff\"},\"Jellyfin\");\n    node(\"span\",heading,{fontSize:\"16px\",color:\"#8796ae\",marginLeft:\"24px\"},\"0.0.1  /  SaoriYuki\");\n    var title = node(\"div\", root, {fontSize:\"32px\",marginBottom:\"12px\"});\n    var status = node(\"div\", root, {fontSize:\"18px\",minHeight:\"44px\",whiteSpace:\"pre-wrap\",color:\"#a4b3ca\"});\n    status.setAttribute(\"role\", \"status\");\n    var content = node(\"div\", root, {flex:\"1\",overflow:\"hidden\",minHeight:\"0\"});\n    var position = node(\"div\", root, {fontSize:\"17px\",minHeight:\"22px\",color:\"#aaaec4\"});\n    var footer = node(\"div\", root, {fontSize:\"16px\",paddingTop:\"16px\",color:\"#8796ae\"}, \"A  Choisir     B  Retour     \u2190 \u2192  Pages\");\n    var chrome = [heading,title,status,content,position,footer];\n    function fitNativeImage() {\n        if (!fullscreenLayer || !nativeImage) return;\n        var html = document.documentElement || {};\n        var width = Number(window.innerWidth) || Number(html.clientWidth) || Number(root.clientWidth) || 1280;\n        var height = Number(window.innerHeight) || Number(html.clientHeight) || Number(root.clientHeight) || 720;\n        var dw=Number(nativeFormat.displayWidth||nativeFormat.width),dh=Number(nativeFormat.displayHeight||nativeFormat.height);\n        if (!(Number.isFinite(dw)&&Number.isFinite(dh)&&dw>0&&dh>0&&dw<=32768&&dh<=32768)) {dw=Number(nativeFormat.width);dh=Number(nativeFormat.height);}\n        var box = window.JellyfinPlayerLayout.fit(width,height,dw,dh);\n        Object.assign(nativeImage.style,{left:box.left+\"px\",top:box.top+\"px\",width:box.width+\"px\",height:box.height+\"px\"});\n    }\n    function enterFullscreen() {\n        fullscreenState = {padding:root.style.padding,background:root.style.backgroundColor,displays:chrome.map(function(n){return n.style.display||\"\";})};\n        chrome.forEach(function(n){n.style.display=\"none\";});root.style.padding=\"0\";root.style.backgroundColor=\"#000\";\n        fullscreenLayer = node(\"div\",root,{position:\"fixed\",left:\"0\",top:\"0\",right:\"0\",bottom:\"0\",backgroundColor:\"#000\",overflow:\"hidden\",zIndex:\"10\"});\n        fullscreenLayer.id = \"jellyfin-fullscreen-player\";\n        fullscreenLayer.setAttribute(\"role\",\"region\");fullscreenLayer.setAttribute(\"aria-label\",\"Lecteur video plein ecran\");\n        return fullscreenLayer;\n    }\n    function leaveFullscreen() {\n        clearTimeout(hudTimer);clearTimeout(seekTimer);hudTimer=null;seekTimer=null;seekTarget=null;\n        playerHud=null;playerTime=null;playerProgress=null;subtitleMenu=null;\n        if (fullscreenLayer && fullscreenLayer.parentNode) fullscreenLayer.parentNode.removeChild(fullscreenLayer);\n        fullscreenLayer = null;fullscreenNotice = null;\n        if (fullscreenState) {\n            chrome.forEach(function(n,i){n.style.display=fullscreenState.displays[i];});\n            root.style.padding=fullscreenState.padding;root.style.backgroundColor=fullscreenState.background;fullscreenState=null;\n        }\n    }\n    function toggleNativePause() {\n        if (!nativePlayer) return;\n        var paused = nativePlayer.togglePause();\n        if(playback)playback.paused=paused;\n        var loading = activePlayback && !activePlayback.started;\n        if (fullscreenNotice) {fullscreenNotice.textContent=paused?\"Pause\":loading?\"Chargement...\":\"\";fullscreenNotice.style.display=paused||loading?\"block\":\"none\";}\n        showPlayerHud();\n    }\n    function playbackSeconds(){\n        if(!playback)return 0;\n        var seconds=playback.offset+(nativePlayer?nativePlayer.stats().seconds:0);\n        return playback.duration?Math.min(playback.duration,seconds):seconds;\n    }\n    function refreshPlayerHud(){\n        if(!playback||!playerTime)return;\n        var seconds=seekTarget===null?playbackSeconds():seekTarget;\n        playerTime.textContent=(seekTarget===null?\"\":\"Aller a  \")+playbackOptions.time(seconds)+\" / \"+(playback.duration?playbackOptions.time(playback.duration):\"--:--\");\n        playerProgress.style.width=(playback.duration?Math.min(100,seconds/playback.duration*100):0)+\"%\";\n    }\n    function showPlayerHud(){\n        if(!playerHud)return;clearTimeout(hudTimer);refreshPlayerHud();playerHud.style.display=\"block\";\n        hudTimer=setTimeout(function(){if(playerHud&&!subtitleMenu&&seekTarget===null)playerHud.style.display=\"none\";},4000);\n    }\n    function createPlayerHud(){\n        playerHud=node(\"div\",fullscreenLayer,{position:\"absolute\",left:\"5%\",right:\"5%\",bottom:\"4%\",padding:\"18px 24px\",backgroundColor:\"rgba(9,13,24,0.9)\",borderRadius:\"12px\",pointerEvents:\"none\"});\n        node(\"div\",playerHud,{fontSize:\"20px\",marginBottom:\"10px\"},playback.item.Name);\n        playerTime=node(\"div\",playerHud,{fontSize:\"18px\",marginBottom:\"10px\"});\n        var track=node(\"div\",playerHud,{height:\"4px\",backgroundColor:\"#39455b\",marginBottom:\"12px\"});\n        playerProgress=node(\"div\",track,{height:\"4px\",width:\"0%\",backgroundColor:\"#55c6ee\"});\n        node(\"div\",playerHud,{fontSize:\"17px\",color:\"#c4d6ec\"},\"\u2190 / \u2192  \u221210 / +10 s     \u2191  Sous-titres     A  Pause     B  Retour\");\n        showPlayerHud();\n    }\n    function seekPlayback(delta){\n        if(!playback||!nativePlayer)return;\n        seekTarget=playbackOptions.clamp((seekTarget===null?playbackSeconds():seekTarget)+delta,playback.duration);\n        showPlayerHud();clearTimeout(seekTimer);\n        seekTimer=setTimeout(function(){\n            seekTimer=null;if(closed||!playback||seekTarget===null)return;\n            var target=seekTarget,old=playback;seekTarget=null;\n            invoke(function(){return playNative(old.item,{offset:target,subtitle:old.subtitle,paused:old.paused,sourceId:old.sourceId});});\n        },450);\n    }\n    function closeSubtitleMenu(){if(subtitleMenu&&subtitleMenu.parentNode)subtitleMenu.parentNode.removeChild(subtitleMenu);subtitleMenu=null;showPlayerHud();}\n    function paintSubtitleMenu(){\n        if(!subtitleMenu||!playback)return;\n        while(subtitleMenu.firstChild)subtitleMenu.removeChild(subtitleMenu.firstChild);\n        node(\"div\",subtitleMenu,{fontSize:\"26px\",marginBottom:\"12px\"},\"Sous-titres\");\n        node(\"div\",subtitleMenu,{fontSize:\"15px\",color:\"#94aac5\",marginBottom:\"14px\"},playback.subtitles.length?\"\u2191 / \u2193  Choisir     A  Appliquer     B  Fermer\":\"Aucune piste de sous-titres disponible\");\n        var choices=[{index:null,label:\"Desactives\"}].concat(playback.subtitles),first=Math.max(0,subtitleSelection-4);\n        choices.slice(first,first+5).forEach(function(s,i){\n            var index=first+i;\n            var row=node(\"div\",subtitleMenu,{padding:\"12px 16px\",marginBottom:\"6px\",fontSize:\"19px\",borderRadius:\"8px\",whiteSpace:\"nowrap\",overflow:\"hidden\",textOverflow:\"ellipsis\",backgroundColor:index===subtitleSelection?\"#243650\":\"#121c2d\",border:\"2px solid \"+(index===subtitleSelection?\"#55c6ee\":\"#263047\")},(s.index===playback.subtitle?\"\u2713  \":\"\")+s.label);\n            row.setAttribute(\"role\",\"button\");row.setAttribute(\"aria-selected\",String(index===subtitleSelection));\n            row.addEventListener(\"click\",function(){if(!busy){subtitleSelection=index;invoke(applySubtitle);}});\n        });\n    }\n    function openSubtitleMenu(){\n        if(!playback||!nativePlayer)return;\n        clearTimeout(seekTimer);seekTimer=null;seekTarget=null;\n        subtitleSelection=playback.subtitles.findIndex(function(s){return s.index===playback.subtitle;})+1;\n        subtitleMenu=node(\"div\",fullscreenLayer,{position:\"absolute\",left:\"20%\",right:\"20%\",top:\"12%\",padding:\"24px\",borderRadius:\"14px\",backgroundColor:\"rgba(9,13,24,0.97)\",zIndex:\"12\"});\n        subtitleMenu.id=\"jellyfin-subtitles\";subtitleMenu.setAttribute(\"role\",\"dialog\");subtitleMenu.setAttribute(\"aria-label\",\"Sous-titres\");\n        paintSubtitleMenu();showPlayerHud();\n    }\n    async function applySubtitle(){\n        if(!playback)return;\n        var old=playback,choice=subtitleSelection===0?null:old.subtitles[subtitleSelection-1].index,seconds=playbackSeconds();\n        closeSubtitleMenu();if(choice===old.subtitle)return;\n        return playNative(old.item,{offset:seconds,subtitle:choice,paused:old.paused,sourceId:old.sourceId});\n    }\n    function message(text) { if (!closed) status.textContent = text; }\n    function listen(target, name, fn) {\n        target.addEventListener(name, fn, true);\n        subscriptions.push(function () { target.removeEventListener(name, fn, true); });\n    }\n    function clearContent(keepPlayer) {\n        if(!keepPlayer)stopVideo();\n        controls = []; selected = 0; firstVisible = 0; paging = null;\n        content.scrollTop = 0;\n        content.style.maxWidth=view===\"server\"||view===\"login\"?\"760px\":\"100%\";\n        content.style.width=\"100%\";\n        position.textContent = \"\";\n        while (content.firstChild) content.removeChild(content.firstChild);\n    }\n    function paint() {\n        if (fullscreenLayer) return;\n        // Gameface may expose scrollIntoView without implementing scrolling.\n        // Hide off-screen rows instead, so the selected row is always rendered.\n        var height = Number(content.clientHeight) || Math.max(62,(Number(window.innerHeight)||720)-300);\n        var rows = Math.max(1,Math.floor(height/86));\n        if (selected < firstVisible) firstVisible = selected;\n        if (selected >= firstVisible + rows) firstVisible = selected - rows + 1;\n        firstVisible = Math.max(0,Math.min(firstVisible,Math.max(0,controls.length-rows)));\n        controls.forEach(function (c, i) {\n            c.node.style.display = i >= firstVisible && i < firstVisible + rows ? \"flex\" : \"none\";\n            c.node.style.borderColor = selected === i ? \"#55c6ee\" : \"#263047\";\n            c.node.style.backgroundColor = selected === i ? \"#243650\" : \"#121c2d\";\n            c.node.setAttribute(\"data-selected\",String(selected === i));\n        });\n        position.textContent = controls.length ? \"Selection \" + (selected+1) + \" / \" + controls.length : \"\";\n    }\n    function button(text, run, subtitle) {\n        var index = controls.length;\n        var n = node(\"button\", content, {display:\"flex\",alignItems:\"flex-start\",justifyContent:\"center\",flexDirection:\"column\",width:\"100%\",boxSizing:\"border-box\",height:\"76px\",minHeight:\"76px\",textAlign:\"left\",padding:\"10px 24px\",marginBottom:\"10px\",border:\"2px solid #263047\",borderRadius:\"14px\",backgroundColor:\"#121c2d\",color:\"#fff\",fontSize:\"21px\",lineHeight:\"26px\",outline:\"none\"});\n        // A plain span with its own font also avoids the game's button label style.\n        node(\"span\", n, {display:\"block\",fontSize:\"21px\",lineHeight:\"26px\",color:\"#fff\",whiteSpace:\"nowrap\",overflow:\"hidden\",textOverflow:\"ellipsis\",maxWidth:\"100%\"}, text);\n        if(subtitle)node(\"span\",n,{display:\"block\",fontSize:\"14px\",lineHeight:\"20px\",color:\"#94aac5\",whiteSpace:\"nowrap\",overflow:\"hidden\",textOverflow:\"ellipsis\",maxWidth:\"100%\"},subtitle);\n        n.setAttribute(\"aria-label\", text);\n        n.type = \"button\"; n.tabIndex = -1;\n        n.addEventListener(\"click\", function () { if (!busy && !editing && !closed) { selected = index; paint(); invoke(run); } });\n        controls.push({node:n,run:run});\n        return n;\n    }\n    async function invoke(run) {\n        if (closed || busy || editing) return;\n        busy = true;\n        try { await run(); } catch (_) { message(\"Erreur inattendue. Reviens en arriere et relance le test.\"); }\n        finally { busy = false; }\n    }\n    function validateServer(value) {\n        value = value.trim().replace(/\\/+$/, \"\");\n        if (!/^https?:\\/\\/[a-z0-9.-]+(?::[0-9]{1,5})?(?:\\/[a-z0-9._~!$&'()*+,;=:@%/-]*)?$/i.test(value)) throw Error(\"Adresse HTTP(S) invalide, sans identifiants ni parametres.\");\n        return value;\n    }\n    function query(values) {\n        return Object.keys(values).filter(function (k) { return values[k] !== undefined; }).map(function (k) { return encodeURIComponent(k) + \"=\" + encod