{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VacooTube: check",
      "type": "process",
      "command": "node",
      "args": [
        "tools/module.cjs",
        "check",
        "--platform",
        "${input:platform}"
      ],
      "problemMatcher": []
    },
    {
      "label": "VacooTube: package",
      "type": "process",
      "command": "node",
      "args": [
        "tools/module.cjs",
        "pack",
        "--platform",
        "${input:platform}"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "platform",
      "type": "promptString",
      "description": "Absolute path to IZ2S Platform"
    }
  ]
}
