#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
#include "abi.glsl"
#include "hb.glsl"
layout(set=0,binding=1,std430) readonly buffer CounterMailbox {uint words[];} mailbox;
void main() {
    c.game = uvec4(mailbox.words[0], mailbox.words[1], mailbox.words[2], c.game.w + 1u);
    c.transition.x = max(0.0, c.transition.x - 1.0 / 15.0);
    if (hbConnected() && (hbPressed() & (HB_B | HB_MINUS)) != 0u) hbExit();
    hbEndFrame();
}
