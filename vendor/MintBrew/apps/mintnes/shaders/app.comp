#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=256) in;
#include "abi.glsl"
#include "hb.glsl"
#include "layout.glsl"
layout(set=0,binding=1,std430) buffer NesStorage {uint words[];} nes;

const uint A=0u,X=1u,Y=2u,SP=3u,PC=4u,P=5u,HALT=6u,FRAME=7u;
const uint PPUCTRL=8u,PPUMASK=9u,PPUSTATUS=10u,PPUADDR=11u,PPULATCH=12u,OAMADDR=13u;
const uint CTRLSTROBE=14u,CTRLSHIFT=15u,CTRLBUTTONS=16u,SCROLLX=17u,SCROLLY=18u;
const uint MENU=19u,MENU_INDEX=20u,MENU_COUNT=21u,LOAD_REQUEST=22u,REFRESH_REQUEST=23u,MINUS_HELD=24u;
const uint CPU_CYCLES=27u,HIT_CHECKED=28u,SPLIT_Y=29u,TOP_CTRL=30u,TOP_SCROLL_X=31u,TOP_SCROLL_Y=58u,PPUTEMP=59u,FINE_X=60u;
const uint APU_LENGTHS=62u;
const uint F_C=1u,F_Z=2u,F_I=4u,F_D=8u,F_B=16u,F_V=64u,F_N=128u;
uint pattern(uint base,uint tile,uint x,uint y);
uint spritePattern(uint ctrl,uint tile,uint x,uint y);
uint spriteZeroRow();
uint lengthValue(uint index){
 const uint values[32]=uint[32](10u,254u,20u,2u,40u,4u,80u,6u,160u,8u,60u,10u,14u,12u,26u,14u,12u,16u,24u,18u,48u,20u,96u,22u,192u,24u,72u,26u,16u,28u,32u,30u);
 return values[index&31u];
}
uint apuLength(uint channel){return (nes.words[APU_LENGTHS]>>(channel*8u))&255u;}
void setApuLength(uint channel,uint value){uint shift=channel*8u;nes.words[APU_LENGTHS]=(nes.words[APU_LENGTHS]&~(255u<<shift))|((value&255u)<<shift);}

uint ram(uint a){return nes.words[NES_RAM+(a&0x7ffu)]&255u;}
void putRam(uint a,uint v){nes.words[NES_RAM+(a&0x7ffu)]=v&255u;}
uint prg(uint a){return nes.words[NES_PRG+((a-0x8000u)&0x7fffu)]&255u;}
uint chr(uint a){return nes.words[NES_CHR+(a&0x1fffu)]&255u;}
uint ntIndex(uint a){
 uint o=(a-0x2000u)&0xfffu,table=o/1024u,offset=o%1024u;
 return (((nes.words[NES_MIRRORING]!=0u)?(table&1u):(table>>1u))*1024u)+offset;
}
uint palIndex(uint a){uint i=(a-0x3f00u)&31u;return i==16u||i==20u||i==24u||i==28u?i-16u:i;}
uint ppuRead(uint a){
 a&=0x3fffu;
 if(a<0x2000u)return chr(a);
 if(a<0x3f00u)return nes.words[NES_NAMETABLE+ntIndex(a)]&255u;
 return nes.words[NES_PALETTE+palIndex(a)]&63u;
}
void ppuWrite(uint a,uint v){
 a&=0x3fffu;
 if(a<0x2000u&&nes.words[NES_CHR_RAM]!=0u)nes.words[NES_CHR+a]=v&255u;
 else if(a>=0x2000u&&a<0x3f00u)nes.words[NES_NAMETABLE+ntIndex(a)]=v&255u;
 else if(a>=0x3f00u)nes.words[NES_PALETTE+palIndex(a)]=v&63u;
}
uint readCpu(uint a){
 a&=0xffffu;
 if(a<0x2000u)return ram(a);
 if(a<0x4000u){
  uint r=a&7u;
  if(r==2u){
   uint sy=nes.words[NES_OAM]&255u;
   if(nes.words[HIT_CHECKED]==0u&&nes.words[CPU_CYCLES]>=2400u+sy*114u){
    uint hit=spriteZeroRow();nes.words[HIT_CHECKED]=1u;
    if(hit<240u){
     nes.words[PPUSTATUS]|=64u;nes.words[SPLIT_Y]=hit;
     nes.words[TOP_CTRL]=nes.words[PPUCTRL];
     nes.words[TOP_SCROLL_X]=nes.words[SCROLLX];nes.words[TOP_SCROLL_Y]=nes.words[SCROLLY];
    }
   }
   uint v=nes.words[PPUSTATUS];nes.words[PPUSTATUS]=v&0x7fu;nes.words[PPULATCH]=0u;return v;
  }
  if(r==4u){uint v=nes.words[NES_OAM+(nes.words[OAMADDR]&255u)];return v&255u;}
  if(r==7u){uint addr=nes.words[PPUADDR],next=ppuRead(addr),v=addr>=0x3f00u?next:nes.words[NES_PPU_READ_BUFFER];nes.words[NES_PPU_READ_BUFFER]=addr>=0x3f00u?ppuRead(addr-0x1000u):next;nes.words[PPUADDR]=(addr+(((nes.words[PPUCTRL]&4u)!=0u)?32u:1u))&0x3fffu;return v;}
  return 0u;
 }
 if(a==0x4016u){uint i=nes.words[CTRLSHIFT],v=(nes.words[CTRLBUTTONS]>>min(i,7u))&1u;if(nes.words[CTRLSTROBE]==0u)nes.words[CTRLSHIFT]=min(i+1u,8u);return i>=8u?1u:v;}
 if(a==0x4015u){uint status=0u;for(uint channel=0u;channel<4u;channel++)if(apuLength(channel)!=0u)status|=1u<<channel;return status;}
