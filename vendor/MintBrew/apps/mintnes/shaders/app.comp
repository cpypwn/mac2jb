}
void writeCpu(uint a,uint v){
 a&=0xffffu;v&=255u;
 if(a<0x2000u){putRam(a,v);return;}
 if(a<0x4000u){
  uint r=a&7u;
  if(r==0u){nes.words[PPUCTRL]=v;nes.words[PPUTEMP]=(nes.words[PPUTEMP]&~0x0c00u)|((v&3u)<<10u);}
  else if(r==1u)nes.words[PPUMASK]=v;
  else if(r==3u)nes.words[OAMADDR]=v;
  else if(r==4u){nes.words[NES_OAM+(nes.words[OAMADDR]&255u)]=v;nes.words[OAMADDR]=(nes.words[OAMADDR]+1u)&255u;}
  else if(r==5u){
   if(nes.words[PPULATCH]==0u){nes.words[SCROLLX]=v;nes.words[FINE_X]=v&7u;nes.words[PPUTEMP]=(nes.words[PPUTEMP]&~31u)|(v>>3u);}
   else{nes.words[SCROLLY]=v;nes.words[PPUTEMP]=(nes.words[PPUTEMP]&~0x73e0u)|((v&0xf8u)<<2u)|((v&7u)<<12u);}
   nes.words[PPULATCH]^=1u;
  }
  else if(r==6u){
   if(nes.words[PPULATCH]==0u)nes.words[PPUTEMP]=(nes.words[PPUTEMP]&0xffu)|((v&63u)<<8u);
   else{nes.words[PPUTEMP]=(nes.words[PPUTEMP]&0x7f00u)|v;nes.words[PPUADDR]=nes.words[PPUTEMP];}
   nes.words[PPULATCH]^=1u;
  }
  else if(r==7u){ppuWrite(nes.words[PPUADDR],v);nes.words[PPUADDR]=(nes.words[PPUADDR]+(((nes.words[PPUCTRL]&4u)!=0u)?32u:1u))&0x3fffu;}
  return;
 }
 if(a==0x4014u){for(uint i=0u;i<256u;i++)nes.words[NES_OAM+((nes.words[OAMADDR]+i)&255u)]=ram((v<<8u)+i);return;}
 if(a==0x4016u){if((v&1u)!=0u){nes.words[CTRLSTROBE]=1u;nes.words[CTRLSHIFT]=0u;}else if(nes.words[CTRLSTROBE]!=0u){nes.words[CTRLSTROBE]=0u;nes.words[CTRLSHIFT]=0u;}return;}
