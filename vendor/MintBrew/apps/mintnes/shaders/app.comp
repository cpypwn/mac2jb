}
uint pixel(uint x,uint y){
 bool top=nes.words[SPLIT_Y]<240u&&y<nes.words[SPLIT_Y];
 uint bg=0u,pal=0u,ctrl=top?nes.words[TOP_CTRL]:nes.words[PPUCTRL],mask=nes.words[PPUMASK];
 if((mask&8u)!=0u&&(x>=8u||(mask&2u)!=0u)){
  uint scrollX=top?nes.words[TOP_SCROLL_X]:nes.words[SCROLLX],scrollY=top?nes.words[TOP_SCROLL_Y]:nes.words[SCROLLY];
  uint wx=(x+scrollX+(((ctrl&1u)!=0u)?256u:0u))%512u;
  uint wy=(y+scrollY+(((ctrl&2u)!=0u)?240u:0u))%480u;
  uint table=(wy/240u)*2u+wx/256u,sx=wx%256u,sy=wy%240u;
  uint tx=sx/8u,ty=sy/8u,base=0x2000u+table*1024u;
  uint nt=nes.words[NES_NAMETABLE+ntIndex(base+ty*32u+tx)]&255u;
  bg=pattern((ctrl&16u)!=0u?0x1000u:0u,nt,sx&7u,sy&7u);
  uint attr=nes.words[NES_NAMETABLE+ntIndex(base+960u+(ty/4u)*8u+tx/4u)]&255u;
  uint shift=((ty&2u)!=0u?4u:0u)+((tx&2u)!=0u?2u:0u);
  pal=((attr>>shift)&3u)*4u;
 }
 uint color=nes.words[NES_PALETTE+(bg==0u?0u:pal+bg)]&63u;
 if((mask&16u)!=0u&&(x>=8u||(mask&4u)!=0u)){for(uint i=0u;i<64u;i++){
  uint sy=nes.words[NES_OAM+i*4u]&255u,sx=nes.words[NES_OAM+i*4u+3u]&255u;
  uint height=(ctrl&32u)!=0u?16u:8u;
  if(y<=sy||y>sy+height||x<sx||x>=sx+8u)continue;
  uint tile=nes.words[NES_OAM+i*4u+1u]&255u,attr=nes.words[NES_OAM+i*4u+2u]&255u;
  uint px=((attr&64u)!=0u)?7u-(x-sx):x-sx,py=((attr&128u)!=0u)?height-(y-sy):y-sy-1u;
  uint sprite=spritePattern(ctrl,tile,px,py);
  if(sprite==0u)continue;
  if(bg==0u||(attr&32u)==0u)color=nes.words[NES_PALETTE+16u+(attr&3u)*4u+sprite]&63u;
  break;
 }}
 return color;
}
void main(){
 if(gl_LocalInvocationID.x==0u){
  c.motion.x+=1.0/60.0;c.state.z++;
  c.transition.x=max(0.0,c.transition.x-1.0/15.0);
  uint held=hbButtons(),pressed=hbPressed();
  if(nes.words[MENU]!=0u){
   uint count=min(nes.words[MENU_COUNT],16u),index=nes.words[MENU_INDEX];
   if((pressed&(HB_B|HB_MINUS))!=0u)hbExit();
   else if(count>0u){
    if((pressed&HB_UP)!=0u)index=(index+count-1u)%count;
    if((pressed&HB_DOWN)!=0u)index=(index+1u)%count;
    nes.words[MENU_INDEX]=index;
    if((pressed&HB_A)!=0u)nes.words[LOAD_REQUEST]=index+1u;
   }
   if((pressed&HB_X)!=0u)nes.words[REFRESH_REQUEST]++;
  }else{
   uint duration=nes.words[MINUS_HELD];
   if((held&HB_MINUS)!=0u){duration++;if(duration>=45u)hbExit();}
   else if(duration>0u){nes.words[MENU]=1u;nes.words[NES_APU_FRAME]=0u;duration=0u;}
   nes.words[MINUS_HELD]=duration;
   if(nes.words[MENU]==0u)cpuFrame();
  }
  hbEndFrame();
 }
 memoryBarrierBuffer();barrier();
 uint x=gl_LocalInvocationID.x;
 if(nes.words[MENU]==0u)for(uint y=0u;y<240u;y++)nes.words[NES_FRAMEBUFFER+y*256u+x]=pixel(x,y);
}
