}
void cpuFrame(){
 nes.words[FRAME]++;
 nes.words[NES_APU_FRAME]=nes.words[FRAME];
 for(uint channel=0u;channel<4u;channel++){
  uint length=apuLength(channel),control=nes.words[NES_APU_BASE+channel*4u];
  if(channel==2u)control=(control&128u)!=0u?32u:0u;
  if(length>0u&&(control&32u)==0u)setApuLength(channel,length>2u?length-2u:0u);
 }
 nes.words[PPUSTATUS]=(nes.words[PPUSTATUS]&~64u)|128u;
 nes.words[CPU_CYCLES]=0u;nes.words[HIT_CHECKED]=0u;nes.words[SPLIT_Y]=240u;
 nes.words[CTRLBUTTONS]=buttons();
 if(nes.words[HALT]==0u){
  if((nes.words[PPUCTRL]&128u)!=0u)nmi();
  uint lastBranch=65536u,repeat=0u;
  for(uint i=0u;i<12000u;i++){
   uint pc=nes.words[PC];if(pc>=0x2000u&&pc<0x8000u){nes.words[HALT]=0x101u;break;}
   uint op=readCpu(pc);
   instruction();if(nes.words[HALT]!=0u)break;
   nes.words[CPU_CYCLES]+=3u;
   if(nes.words[CPU_CYCLES]>=29780u)break;
   if(op==0x4cu&&nes.words[PC]==pc)break;
   if((op==0xf0u||op==0x10u)&&nes.words[PC]<pc){if(pc==lastBranch)repeat++;else{lastBranch=pc;repeat=0u;}if(repeat>32u)break;}
  }
 }
 nes.words[PPUSTATUS]&=0x7fu;
}
uint pattern(uint base,uint tile,uint x,uint y){uint at=base+tile*16u+y;uint bit=7u-x;return ((chr(at)>>bit)&1u)|(((chr(at+8u)>>bit)&1u)<<1u);}
uint spritePattern(uint ctrl,uint tile,uint x,uint y){
 if((ctrl&32u)!=0u)return pattern((tile&1u)*0x1000u,(tile&0xfeu)+(y>>3u),x,y&7u);
 return pattern((ctrl&8u)!=0u?0x1000u:0u,tile,x,y);
}
uint backgroundPixel(uint x,uint y,uint ctrl,uint scrollX,uint scrollY){
 uint wx=(x+scrollX+(((ctrl&1u)!=0u)?256u:0u))%512u;
 uint wy=(y+scrollY+(((ctrl&2u)!=0u)?240u:0u))%480u;
 uint table=(wy/240u)*2u+wx/256u,sx=wx%256u,sy=wy%240u;
 uint addr=0x2000u+table*1024u+(sy/8u)*32u+sx/8u;
 uint tile=nes.words[NES_NAMETABLE+ntIndex(addr)]&255u;
 return pattern((ctrl&16u)!=0u?0x1000u:0u,tile,sx&7u,sy&7u);
}
uint spriteZeroRow(){
 uint mask=nes.words[PPUMASK],ctrl=nes.words[PPUCTRL];
 if((mask&24u)!=24u)return 240u;
 uint sy=nes.words[NES_OAM]&255u,tile=nes.words[NES_OAM+1u]&255u,attr=nes.words[NES_OAM+2u]&255u,sx=nes.words[NES_OAM+3u]&255u;
 uint height=(ctrl&32u)!=0u?16u:8u;
 for(uint row=0u;row<height;row++){
  uint y=sy+1u+row;if(y>=240u)break;
  uint py=((attr&128u)!=0u)?height-1u-row:row;
  for(uint col=0u;col<8u;col++){
   uint x=sx+col;if(x>=255u)break;
   if(x<8u&&((mask&6u)!=6u))continue;
   uint px=((attr&64u)!=0u)?7u-col:col;
   if(spritePattern(ctrl,tile,px,py)!=0u&&backgroundPixel(x,y,ctrl,nes.words[SCROLLX],nes.words[SCROLLY])!=0u)return y;
  }
