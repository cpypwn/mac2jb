  nes.words[NES_APU_BASE+a-0x4000u]=v;
  if(a==0x4015u){for(uint channel=0u;channel<4u;channel++)if((v&(1u<<channel))==0u)setApuLength(channel,0u);}
  else if(a==0x4003u||a==0x4007u||a==0x400bu||a==0x400fu){
   uint channel=(a-0x4003u)/4u;
   if((nes.words[NES_APU_BASE+0x15u]&(1u<<channel))!=0u)setApuLength(channel,lengthValue(v>>3u));
  }
  uint sequence=nes.words[NES_APU_SEQUENCE]+1u,slot=(sequence-1u)%NES_APU_EVENT_COUNT;
  nes.words[NES_APU_EVENT_BASE+slot*3u]=a;
  nes.words[NES_APU_EVENT_BASE+slot*3u+1u]=v;
  nes.words[NES_APU_EVENT_BASE+slot*3u+2u]=sequence;
  nes.words[NES_APU_SEQUENCE]=sequence;return;
 }
}
uint fetch(){uint pc=nes.words[PC]&0xffffu;nes.words[PC]=(pc+1u)&0xffffu;return readCpu(pc);}
uint fetch16(){uint lo=fetch();return lo|(fetch()<<8u);}
void setFlag(uint bit,bool on){nes.words[P]=on?nes.words[P]|bit:nes.words[P]&~bit;}
bool flag(uint bit){return (nes.words[P]&bit)!=0u;}
void setZN(uint v){setFlag(F_Z,(v&255u)==0u);setFlag(F_N,(v&128u)!=0u);}
void push(uint v){putRam(0x100u+nes.words[SP],v);nes.words[SP]=(nes.words[SP]-1u)&255u;}
uint pop(){nes.words[SP]=(nes.words[SP]+1u)&255u;return ram(0x100u+nes.words[SP]);}
uint modeAddr(uint mode){
 if(mode==1u){uint z=(fetch()+nes.words[X])&255u;return ram(z)|(ram((z+1u)&255u)<<8u);}
 if(mode==5u)return fetch();
 if(mode==9u){uint a=nes.words[PC];nes.words[PC]=(a+1u)&0xffffu;return a;}
 if(mode==13u)return fetch16();
 if(mode==17u){uint z=fetch();return (ram(z)|(ram((z+1u)&255u)<<8u))+nes.words[Y]&0xffffu;}
 if(mode==21u)return (fetch()+nes.words[X])&255u;
 if(mode==25u)return (fetch16()+nes.words[Y])&0xffffu;
 if(mode==29u)return (fetch16()+nes.words[X])&0xffffu;
 return 0u;
}
void compare(uint a,uint v){uint d=(a-v)&255u;setFlag(F_C,a>=v);setZN(d);}
void addCarry(uint v){uint a=nes.words[A],carry=uint(flag(F_C)),sum=a+v+carry,r=sum&255u;setFlag(F_C,sum>255u);setFlag(F_V,((~(a^v)&(a^r))&128u)!=0u);nes.words[A]=r;setZN(r);}
uint buttons(){
 uint b=hbButtons(),v=0u;
 if((b&HB_A)!=0u)v|=1u;
 if((b&(HB_B|HB_Y))!=0u)v|=2u;
 if((b&HB_X)!=0u)v|=4u;
 if((b&HB_PLUS)!=0u)v|=8u;
 if((b&HB_UP)!=0u)v|=16u;
 if((b&HB_DOWN)!=0u)v|=32u;
 if((b&HB_LEFT)!=0u)v|=64u;
 if((b&HB_RIGHT)!=0u)v|=128u;
 return v;
}
void nmi(){
 uint pc=nes.words[PC];push(pc>>8u);push(pc&255u);push((nes.words[P]&~F_B)|32u);setFlag(F_I,true);
 nes.words[PC]=readCpu(0xfffau)|(readCpu(0xfffbu)<<8u);
}
bool branch(uint op,uint off){
 bool take=(op==0x10u&&!flag(F_N))||(op==0x30u&&flag(F_N))||(op==0x50u&&!flag(F_V))||(op==0x70u&&flag(F_V))||(op==0x90u&&!flag(F_C))||(op==0xb0u&&flag(F_C))||(op==0xd0u&&!flag(F_Z))||(op==0xf0u&&flag(F_Z));
 if(take)nes.words[PC]=uint((int(nes.words[PC])+int(off<128u?off:off-256u))&65535);
 return take;
}
void instruction(){
 uint op=fetch();
 if((op&3u)==1u){
  uint group=op>>5u,mode=op&31u;
  if(mode!=1u&&mode!=5u&&mode!=9u&&mode!=13u&&mode!=17u&&mode!=21u&&mode!=25u&&mode!=29u){nes.words[HALT]=op+1u;return;}
  if(group==4u&&mode==9u){nes.words[HALT]=op+1u;return;}
  uint addr=modeAddr(mode),v=group==4u?0u:readCpu(addr),a=nes.words[A];
  if(group==0u){nes.words[A]=a|v;setZN(nes.words[A]);}
  else if(group==1u){nes.words[A]=a&v;setZN(nes.words[A]);}
  else if(group==2u){nes.words[A]=a^v;setZN(nes.words[A]);}
  else if(group==3u)addCarry(v);
  else if(group==4u)writeCpu(addr,a);
  else if(group==5u){nes.words[A]=v;setZN(v);}
  else if(group==6u)compare(a,v);
  else addCarry(v^255u);
  return;
 }
 if((op&0x1fu)==0x10u){branch(op,fetch());return;}
 if(op==0xa2u||op==0xa6u||op==0xb6u||op==0xaeu||op==0xbeu){uint at=op==0xa2u?modeAddr(9u):op==0xa6u?modeAddr(5u):op==0xb6u?(fetch()+nes.words[Y])&255u:op==0xaeu?modeAddr(13u):modeAddr(25u);nes.words[X]=readCpu(at);setZN(nes.words[X]);return;}
 if(op==0xa0u||op==0xa4u||op==0xb4u||op==0xacu||op==0xbcu){uint at=op==0xa0u?modeAddr(9u):op==0xa4u?modeAddr(5u):op==0xb4u?modeAddr(21u):op==0xacu?modeAddr(13u):modeAddr(29u);nes.words[Y]=readCpu(at);setZN(nes.words[Y]);return;}
 if(op==0x86u||op==0x96u||op==0x8eu){uint at=op==0x86u?modeAddr(5u):op==0x96u?(fetch()+nes.words[Y])&255u:modeAddr(13u);writeCpu(at,nes.words[X]);return;}
 if(op==0x84u||op==0x94u||op==0x8cu){uint at=op==0x84u?modeAddr(5u):op==0x94u?modeAddr(21u):modeAddr(13u);writeCpu(at,nes.words[Y]);return;}
 if(op==0xe0u||op==0xe4u||op==0xecu){compare(nes.words[X],readCpu(modeAddr(op==0xe0u?9u:op==0xe4u?5u:13u)));return;}
 if(op==0xc0u||op==0xc4u||op==0xccu){compare(nes.words[Y],readCpu(modeAddr(op==0xc0u?9u:op==0xc4u?5u:13u)));return;}
 if(op==0x24u||op==0x2cu){uint v=readCpu(modeAddr(op==0x24u?5u:13u));setFlag(F_Z,(nes.words[A]&v)==0u);setFlag(F_N,(v&128u)!=0u);setFlag(F_V,(v&64u)!=0u);return;}
 if(op==0xe6u||op==0xf6u||op==0xeeu||op==0xfeu||op==0xc6u||op==0xd6u||op==0xceu||op==0xdeu){uint at=(op&15u)==6u?(((op&16u)!=0u)?modeAddr(21u):modeAddr(5u)):(((op&16u)!=0u)?modeAddr(29u):modeAddr(13u));uint v=(readCpu(at)+((op&32u)!=0u?1u:255u))&255u;writeCpu(at,v);setZN(v);return;}
 if(op==0x0au||op==0x4au||op==0x2au||op==0x6au||op==0x06u||op==0x16u||op==0x0eu||op==0x1eu||op==0x46u||op==0x56u||op==0x4eu||op==0x5eu||op==0x26u||op==0x36u||op==0x2eu||op==0x3eu||op==0x66u||op==0x76u||op==0x6eu||op==0x7eu){
  bool accum=(op&15u)==10u;uint at=0u;
  if(!accum)at=(op&15u)==6u?(((op&16u)!=0u)?modeAddr(21u):modeAddr(5u)):(((op&16u)!=0u)?modeAddr(29u):modeAddr(13u));
  uint v=accum?nes.words[A]:readCpu(at),kind=op&0xe0u,r=0u;
  if(kind==0u){setFlag(F_C,(v&128u)!=0u);r=(v<<1u)&255u;}
  else if(kind==0x20u){uint c=uint(flag(F_C));setFlag(F_C,(v&128u)!=0u);r=((v<<1u)|c)&255u;}
  else if(kind==0x40u){setFlag(F_C,(v&1u)!=0u);r=v>>1u;}
  else{uint c=uint(flag(F_C));setFlag(F_C,(v&1u)!=0u);r=(v>>1u)|(c<<7u);}
  if(accum)nes.words[A]=r;else writeCpu(at,r);setZN(r);return;
 }
 if(op==0x4cu){nes.words[PC]=fetch16();return;}
 if(op==0x6cu){uint at=fetch16();nes.words[PC]=readCpu(at)|(readCpu((at&0xff00u)|((at+1u)&255u))<<8u);return;}
 if(op==0x20u){uint target=fetch16(),ret=(nes.words[PC]-1u)&65535u;push(ret>>8u);push(ret&255u);nes.words[PC]=target;return;}
 if(op==0x00u){uint ret=(nes.words[PC]+1u)&65535u;push(ret>>8u);push(ret&255u);push(nes.words[P]|F_B|32u);setFlag(F_I,true);nes.words[PC]=readCpu(0xfffeu)|(readCpu(0xffffu)<<8u);return;}
 if(op==0x60u){nes.words[PC]=((pop()|(pop()<<8u))+1u)&65535u;return;}
 if(op==0x40u){nes.words[P]=(pop()|32u)&~F_B;nes.words[PC]=pop()|(pop()<<8u);return;}
 if(op==0x48u){push(nes.words[A]);return;}
 if(op==0x68u){nes.words[A]=pop();setZN(nes.words[A]);return;}
 if(op==0x08u){push(nes.words[P]|F_B|32u);return;}
 if(op==0x28u){nes.words[P]=pop()|32u;return;}
 if(op==0xaau){nes.words[X]=nes.words[A];setZN(nes.words[X]);return;}
 if(op==0xa8u){nes.words[Y]=nes.words[A];setZN(nes.words[Y]);return;}
 if(op==0x8au){nes.words[A]=nes.words[X];setZN(nes.words[A]);return;}
 if(op==0x98u){nes.words[A]=nes.words[Y];setZN(nes.words[A]);return;}
 if(op==0xbau){nes.words[X]=nes.words[SP];setZN(nes.words[X]);return;}
 if(op==0x9au){nes.words[SP]=nes.words[X];return;}
 if(op==0xe8u||op==0xcau||op==0xc8u||op==0x88u){uint r=(op==0xe8u||op==0xcau)?X:Y;nes.words[r]=(nes.words[r]+((op==0xe8u||op==0xc8u)?1u:255u))&255u;setZN(nes.words[r]);return;}
 if(op==0x18u||op==0x38u){setFlag(F_C,op==0x38u);return;}
 if(op==0x58u||op==0x78u){setFlag(F_I,op==0x78u);return;}
 if(op==0xd8u||op==0xf8u){setFlag(F_D,op==0xf8u);return;}
 if(op==0xb8u){setFlag(F_V,false);return;}
 if(op==0xeau)return;
