{
  "format": "izlauncher.module",
  "version": "1.14.4",
  "id": "blitbun",
  "name": "BlitBun",
  "moduleVersion": "1.14.4",
  "switch": {
    "entry": "switch/app.json",
    "files": [
      "switch/app.json",
      "switch/icon.png",
      "switch/icon.svg",
      "switch/icon.webp",
      "switch/modules/pc-screen-draw.glsl",
      "switch/modules/pc-screen-input.glsl",
      "switch/modules/pc-screen.glsl",
      "switch/modules/tiny-calc.glsl"
    ],
    "abi": 1
  },
  "server": {
    "entry": "server/entry.cjs",
    "implementations": {
      "create": "modules/blitbun/server/application-host.cjs",
      "stream": "modules/blitbun/server/lib/hl2-stream.cjs",
      "sessionHook": "modules/blitbun/server/session-hook.cjs",
      "codec": "modules/blitbun/server/lib/pc-codec.js",
      "windowFocus": "modules/blitbun/server/lib/window-focus.cjs",
      "frameAvailability": "modules/blitbun/server/lib/frame-availability.cjs",
      "nativeWindow": "modules/blitbun/server/lib/native-window-capture.cjs"
    },
    "runtime": "node",
    "sessionHook": "sessionHook",
    "activation": {
      "offset": 968,
      "sequenceOffset": 972,
      "values": [
        1,
        2,
        3,
        5,
        6,
        7
      ],
      "exclusiveGroup": "video-stream"
    },
    "assets": [
      "server/lib/block-delta-worker.cjs",
      "server/lib/capture-audio.js",
      "server/lib/frame-codec.wasm",
      "server/lib/frame-pacing.js",
      "server/lib/frame-worker.cjs",
      "server/lib/pc-codec.js",
      "server/lib/pc-gpu-codec.js",
      "server/lib/pc-screen.html",
      "server/lib/pcm-capture-worklet.js",
      "server/lib/remote/window-frames.py",
      "server/lib/fast-compression.cjs",
      "server/native/build.json",
      "server/native/compression.c",
      "server/lib/fast-frame-codec.cjs",
      "server/native/bc1/build.json",
      "server/native/bc1/encoder.c",
      "server/lib/delta-compressor.cjs",
      "server/lib/delta-prefetch.cjs",
      "server/lib/native-window-capture.cjs",
      "server/lib/native-window-audio.cjs",
      "server/lib/remote/native-windows.py",
      "server/lib/frame-availability.cjs",
      "server/lib/delta-wire.cjs",
      "server/lib/inflate-policy.cjs",
      "server/lib/route-gate.cjs",
      "server/standalone-service.cjs",
      "server/lib/composite-source.cjs",
      "server/lib/remote/composite-surface.py",
      "server/lib/stream-preview.cjs"
    ],
    "systemDependencies": [
      {
        "command": "ffmpeg",
        "purpose": "Selected-window capture",
        "optional": false,
        "platforms": [
          "linux-x64",
          "linux-arm64"
        ]
      },
      {
        "command": "parec",
        "purpose": "Per-application audio capture",
        "optional": false,
        "platforms": [
          "linux-x64",
          "linux-arm64"
        ]
      },
      {
        "command": "pactl",
        "purpose": "Audio routing discovery",
        "optional": false,
        "platforms": [
          "linux-x64",
          "linux-arm64"
        ]
      },
      {
        "command": "python3",
        "purpose": "Window selection helpers",
        "optional": false,
        "platforms": [
          "linux-x64",
          "linux-arm64"
        ]
      },
      {
        "command": "cc",
        "purpose": "Optional native codec acceleration",
        "optional": true,
        "platforms": [
          "linux-x64",
          "linux-arm64"
        ]
      },
      {
        "command": "pkg-config",
        "purpose": "Optional native library discovery",
        "optional": true,
        "platforms": [
          "linux-x64",
          "linux-arm64"
        ]
      }
    ]
  },
  "package": "blitbun.izm",
  "legacy": {
    "appFolder": "blitbun",
    "packageNames": [
      "pc-screen.izp",
      "izlink.izp",
      "pc-screen.izs",
      "pc-screen.izm"
    ],
    "moduleIds": [
      "pc-screen"
    ]
  },
  "formatVersion": 1,
  "apiVersion": 1,
  "author": "IZMYSH and upstream contributors",
  "platforms": [
    "linux-x64",
    "linux-arm64"
  ],
  "requires": {
    "platformApi": 1,
    "shell": "izlauncher",
    "consoleAbi": 1,
    "moduleDirectories": true
  },
  "capabilities": {
    "streaming": true
  },
  "dependencies": [],
  "settingsSchema": [],
  "license": "GPL-2.0-or-later",
  "provides": {
    "stream-host": "create"
  },
  "description": "PC-to-Switch 2 streaming · video, audio and optional controller forwarding",
  "installationDirectory": "BlitBun"
}
