{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "urn:izlauncher:shell:1",
  "title": "IZlauncher shell API 1",
  "required": [
    "format",
    "apiVersion",
    "id",
    "name",
    "version",
    "platforms",
    "entry",
    "consoleAbi"
  ],
  "properties": {
    "format": {
      "const": "izlauncher.shell"
    },
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "linux-x64",
          "linux-arm64",
          "win32-x64",
          "win32-arm64",
          "darwin-x64",
          "darwin-arm64"
        ]
      }
    },
    "consoleAbi": {
      "const": 1
    },
    "moduleShells": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
      },
      "description": "Module shell formats implemented by this shell; console ABI and host checks still apply."
    }
  }
}
